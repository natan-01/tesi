 721   
 722   
 723  * ================= Initial domestic gross production ========================= *
 724  XDZ(sec,reg)         = sum(good,USGN(sec,good))*indicPROD(reg,sec);
 725  XDDZ(reg,sec,good) = USGN(sec,good)*indicProd(reg,sec);
 726  *XDZ_sum(sec)         = sum(reg,XDZ(sec,reg));
 727  *display XDZ,XDZ_sum;
