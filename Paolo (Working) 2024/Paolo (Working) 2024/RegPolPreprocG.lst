 143   
 144  * ------------------------------------------------
 145  * 1) Map SAM-data into Panda sectors and goods.
 146  * ------------------------------------------------
 147  * Split the national SAM into nine submatrices and map into Panda formats
 148  parameters
 149       PGG(Pgood,Pgood), PSS(Psec,Psec)
 150       PGS(Pgood ,Psec), PGF(Pgood ,Pfin)
 151       PSG(Psec  ,Pgood), PSF(Psec  ,Pfin)
 152       PFG(Pfin,Pgood), PFS(Pfin,Psec), PFF(Pfin,Pfin)
 153  ;
 154   
 155  * Map into Panda notation
 156  PGG(Pgood,p_gg) = sum((SAMgood,SAMgood2)$(mapGoodP(SAMgood,Pgood) and mapG
      oodP(SAMgood2,p_gg) ), SAMin(SAMgood,SAMgood2) );
 157  PGS(Pgood,p_ss) = sum((SAMgood,SAMsec)$(mapGoodP(SAMgood,Pgood) and mapSec
      P(SAMsec,p_ss) ), SAMin(SAMgood,SAMsec) );
 158  PGF(Pgood,p_ff) = sum((SAMgood,SAMfin)$(mapGoodP(SAMgood,Pgood) and mapFin
      P(SAMfin,p_ff)), SAMin(SAMgood,SAMfin) );
 159  PSG(Psec,p_gg) = sum((SAMsec,SAMgood)$(mapSecP(SAMsec,Psec) and mapGoodP(S
      AMgood,p_gg) ), SAMin(SAMsec,SAMgood) );
 160  PSS(Psec,p_ss) = sum((SAMsec,SAMsec2)$(mapSecP(SAMsec,Psec) and mapSecP(SA
      Msec2,p_ss) ),  SAMin(SAMsec,SAMsec2) );
 161  PSF(Psec,p_ff) = sum((SAMsec,SAMfin)$(mapSecP(SAMsec,Psec) and mapFinP(SAM
      fin,p_ff)),SAMin(SAMsec,SAMfin) );
 162  PFG(Pfin,p_gg) = sum((SAMgood,SAMfin)$(mapGoodP(SAMgood,p_gg) and mapFinP(
      SAMfin,Pfin)), SAMin(SAMfin,SAMgood) );
 163  PFS(Pfin,p_ss) = sum((SAMsec,SAMfin)$(mapSecP(SAMsec,p_ss) and mapFinP(SAM
      fin,Pfin)), SAMin(SAMfin,SAMsec) );
 164  PFF(Pfin,p_ff) = sum((SAMfin,SAMFin2)$(mapFinP(SAMfin,Pfin) and mapFinP(SA
      Mfin2,p_ff)), SAMin(SAMfin,SAMfin2));
 165   
 166  * PGG and PSS should always only have zero entries: check
 167  display "--- Check if GxG and SxS matrices are zero:";
 168  parameters sumPGG, sumPSS;
 169  sumPGG = sum((Pgood,p_gg),PGG(Pgood,p_gg));
 170  sumPSS = sum((Psec,p_ss),PSS(Psec,p_ss));
 171  display sumPGG, sumPSS;
 172  * AW to do: stop execution of the code if this is not the case (within tol
      erance bounds) - or do something else?
 173  * if everything is fine: don't consider these matrices anymore for the pre
      processing
 174  scalars
 175  SAM_sum_p  !!intial sum if the SAM
 176  SAM_sum_init !!initial sum of the SAM
 177  ;
 178   
 179  * Checking the sum value of the initial SAM
 180  SAM_sum_init = sum((rsam,csam),SAMin(rsam,rsam))  ;
 181   
 182  * Checking the sum value of the p SAM
 183  SAM_sum_p = sum((Pgood,p_gg),PGG(Pgood,p_gg))+sum((Pgood,p_ss),PGS(Pgood,p
      _ss))+sum((Pgood,p_ff),PGF(Pgood,p_ff))+sum((Psec,p_gg),PSG(Psec,p_gg))+su
      m((Psec,p_ss),PSS(Psec,p_ss))+
 184  sum((Psec,p_ff),PSF(Psec,p_ff))+sum((Pfin,p_gg),PFG(Pfin,p_gg))+sum((Pfin,
      p_ss),PFS(Pfin,p_ss))+sum((Pfin,p_ff),PFF(Pfin,p_ff)) ;
 185   
