 360     if ((distrPCountyincome_sec('99',sec)/sum(cc, distrPCountyincome_sec(cc
      ,sec))<checktol),
 361             distrPCountyincome_sec('99',sec)=0;
 362      );
 363      );
 364      );
 365  display "Mark 4"
 366  * normalise keys and map from county to regional level
 367  loop(sec,
