 617  CZ(reg,good)              initial consumer demand for goods and leisure
 618  CBUDZ(reg)                budjett restriction to the household
 619  CGZ(reg,good)             initial government demand for goods
 620  IZ(reg,good)              initial investment demand private
 621  SVZ(reg,good)             initial changes in inventories
 622   
 623  EROWZ(reg,good)           initial exports to RoW
 624  MROWZ(reg,good)           initial imports from RoW
 625  TRADEZ(good,reg,reg)      initial domestic production delivered to domesti
      c region reg
 626  TRADEZ_f(good,reg)        initial domestic production delivered from
 627  TRADEZ_t(good,reg)        initial domestic production delivered to
 628  *  not inclued yet EZ(cnt,com)       total exports
 629   
 630  TMCZ(good)                transport and trade margins
 631  TMCZ_R(reg,good)          regional version of trade and transportmargins
 632  TMCRZ(reg,reg,good)       transp and trade margins
 633  TAXCZR(reg,rr,good)       product taxes
 634  TMXZ(reg,good)            initial consumption of good for prod of transpor
      t and trade margins
 635   
 636  TTYZ(reg)                 income taxes
 637  TRANSFZ(reg)              govermental transfers to households
 638   
 639  SHZ(reg)                  initial household savings
 640  SGZ(reg)                  initial goverment savings
 641  SROWZ(reg)                savings from RoW
 642  INVZ(sec,reg)             sectoral investments
 643   
 644  TRROWZ(reg)               net transfers to government (closing trade balan
      ce)
 645  TRHROWZ(reg)              initial income of households tranfered to or rec
      eived from RoW (closing trade balance)
 646   
 647  TAXCZ(good)                net taxes on products
 648  TAXCZ_R(reg,good)          net taxes on products for regions
 649  TAXPZ(sec,reg)             net taxes on production
 650  *TAXPZ_R(sec,reg)           net taxes on production for regions
 651   
 652  LSZ(reg)                  initial labour endowment
 653  KSZ(reg)                  initial capital endowment
 654   
 655  ITZ(reg)                  total investments
 656  CBUDZ(reg)                households consumption budget
 657  CBUDGZ(reg)               governmental consumption budget
 658   
 659  XZ(reg,good)               initial domestic sales
 660  XXDZ(reg,good)             domestic products supply to domestic market
 661   
 662  TMTZ(reg)                 initial total trade and transport margins
 663   
 664  *TAXCZ(sec)                other taxes on products
 665  *VATTZ(sec)                VAT taxes on products
 666  *EXCISZ(sec)               excise taxes on products
 667  YZ(reg)                   income of the households
 668  TAXRZ(reg)                tax revenues of the government
 669  TRYZ                      initial income tax revenues
 670  capital_check(reg,sec)    check if endowments are balanced - use capital a
      s balancing element
 671   
 672  * AW 16/12: in order to find out where division by zero occurs & for which
       sec + good
 673  ccount(sec), gcount(good)
 674  rccount(reg,sec), rgcount(reg,good)
 675  grrcount(good,reg,reg)
 676   
 677  diffXD_n(good), diffX_n(good)
 678  investment_bal_n, trade_bal_global_n
 679  ;
 680   
 681  display mapPFin;
 682   
 683  Display "Checking balances for national SAM:" ;
 684  ** AW 26/1-15: checking whether balances are satisfied for the national SA
      M at all
 685  * Sales balances:
 686  * regional version: sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good) - sum(rr,
       TRADEZ(good,reg,rr)) ;
 687  diffXD_n(good) = sum(sec, USGN(sec,good))- sum(fin$mapPFin('149',fin),UGFN
      (good,fin))
 688          - (sum(fin$mapPFin('146',fin),UGFN(good,fin))-sum(fin$mapPFin('146
      ',fin),UFGN(fin,good)));
 689  display "Sales balances", diffXD_n;
 690  * Demand balances:
 691  * regional version: diffX(reg,good) = XZ(reg,good) - MROWZ(reg,good) - sum
      (rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good));
 692  diffX_n(good) =  sum(fin$mapPFin('142',fin),UGFN(good,fin))+ sum(fin$mapPF
      in('143',fin),UGFN(good,fin)) + sum(fin$mapPFin('144',fin),UGFN(good,fin))
 693                    + sum(fin$mapPFin('145',fin),UGFN(good,fin)) + (sum(fin$
      mapPFin('146',fin),UGFN(good,fin))-sum(fin$mapPFin('146',fin),UFGN(fin,goo
      d)))
 694                    + sum(sec,UGSN(good,sec)) - sum(fin$mapPFin('149',fin),U
      FGN(fin,good));
 695  display "Demand balances", diffX_n;
 696  * Investment balance:
 697  * regional version: investment_bal(reg) = sum(sec,INVZ(sec,reg)) + SHZ(reg
      )  + SGZ(reg) + SROWZ(reg)-ITZ(reg) - sum(good, SVZ(reg,good));
 698  investment_bal_n = sum((fin,sec)$mapPFin('144',fin),UFSN(fin,sec)) + sum((
      fin,ff)$(mapPFin('144',fin) and mapPFin('142',ff)),UFFN(fin,ff))
 699                      + sum((fin,ff)$(mapPFin('144',fin) and mapPFin('143',f
      f)),UFFN(fin,ff))
 700                      + (sum((fin,ff)$(mapPFin('144',fin) and mapPFin('149',
      ff)),UFFN(fin,ff)) - sum((fin,ff)$(mapPFin('149',fin) and mapPFin('144',ff
      )),UFFN(fin,ff)))
 701                      -sum((good,fin)$mapPFin('144',fin),UGFN(good,fin)) - s
      um((good,fin)$mapPFin('145',fin),UGFN(good,fin));
 702   
 703  display "Investment balance", investment_bal_n;
 704   
 705  * Global trade balance:
 706  * regional version: trade_bal_global(reg) = sum(good,EROWZ(reg,good)) + su
      m((good,rr),TRADEZ(good,reg,rr)) + sum(good,TMXZ(reg,good)) -  TRHROWZ(reg
      ) +  TRROWZ(reg) + SROWZ(reg)
 707  *  -  sum(good,MROWZ(reg,good)) - sum((good,rr),TRADEZ(good,rr,reg) + TMCR
      Z(rr,reg,good));
 708  *tradebal_glob(reg)=sum(good,mSAM(reg,good,'trade'))
 709  *      + (sum(fin$mapPFin('142',fin),mSAM(reg,fin,'trade')-mSAM(reg,'trade
      ',fin)))
 710  *      + (sum(fin$mapPFin('143',fin),mSAM(reg,fin,'trade') - mSAM(reg,'tra
      de',fin)))
 711  *      + (sum(fin$mapPFin('144',fin),mSAM(reg,fin,'trade') - mSAM(reg,'tra
      de',fin)))
 712  *      - sum(good,mSAM(reg,'trade',good)) ;
 713   
 714  trade_bal_global_n = sum((fin,good)$mapPFin('149',fin),UGFN(good,fin))
 715        + (sum((fin,ff)$(mapPFin('142',fin) and mapPFin('149',ff)),UFFN(fin,
      ff)-UFFN(ff,fin)))
 716        + (sum((fin,ff)$(mapPFin('143',fin) and mapPFin('149',ff)),UFFN(fin,
      ff) - UFFN(ff,fin)))
 717        + (sum((fin,ff)$(mapPFin('144',fin) and mapPFin('149',ff)),UFFN(fin,
      ff) - UFFN(ff,fin)))
 718        - sum((fin,good)$mapPFin('149',fin),UFGN(fin,good)) ;
 719   
 720  display "Global trade balance", trade_bal_global_n;
