 809   
 810  * ================= Consumer demand       =================================== *
 811  CZ(reg,good)     = sum(fin$mapPFin('142',fin),UGFN(good,fin))*indicCONS(reg,good) ;
 812  CBUDZ(reg)   =  sum(good,CZ(reg,good)) ;
 813   
 814  * =================          Savings and transfers                       ====================== *
 815  TRYZ            =  sum((fin,ff)$(mapPFin('134',fin) and mapPFin('142',ff)),UFFN(fin,ff)) ;
 816   
 817  TTYZ(reg)       = TRYZ*YZ(reg)/sum(rr,YZ(rr));
 818  *TTYZ(reg)       =  sum((fin,ff)$(mapPFin('134',fin) and mapPFin('142',ff)),UFFN(fin,ff))* sum(good,CZ(reg,good))/sum((rr,gg),CZ(rr,gg));
 819   
 820  SHZ(reg)     =  sum((fin,ff)$(mapPFin('144',fin) and mapPFin('142',ff)),UFFN(fin,ff))*(YZ(reg)- TRYZ*YZ(reg)/sum(rr,YZ(rr)))
 821                     /sum(reg2,(YZ(reg2)- TRYZ*YZ(reg2)/sum(rr,YZ(rr))) ) ;
 822   
 823  TRANSFZ(reg)         =     sum((fin,ff)$(mapPFin('142',fin) and mapPFin('143',ff)),UFFN(fin,ff))* ( CBUDZ(reg) - YZ(reg)
 824                     +  TRYZ*YZ(reg)/sum((reg2),YZ(reg2)) + SHZ(reg))
 825                     /sum((rr),( CBUDZ(rr) - YZ(rr)
 826                     +  TRYZ*YZ(rr)/sum((reg2),YZ(reg2)) + SHZ(rr)) ) ;
 827   
 828  *TRFZ(th,reg)     =  SAM("59","60")*( CBUDZ(th,reg) - YZ(th,reg)
 829  *                   +  TRYZ*YZ(th,reg)/sum((thh,regg),YZ(thh,regg)) + SHZ(th,reg))
 830  *                   /sum((thhh,reggg),( CBUDZ(thhh,reggg) - YZ(thhh,reggg)
 831  *                   +  TRYZ*YZ(thhh,reggg)/sum((thh,regg),YZ(thh,regg)) + SHZ(thhh,reggg)) ) ;
 832   
 833  display TRANSFZ;
 834   
 835  TAXCZ(good)       =     sum(fin$mapPFin('138',fin),UFGN(fin,good)) ;
 836   
 837  *Column parameters
 838  * ================= Cheking if EROWZ is smaler than XDDZ and reducing EROWZ and MROWZ with this amount       ====================== *
 839  * We are adding a small number: 0.1, because we don't want to have the number 0
 840  parameter Adj_EROWZ_MROWZ(good),EROWZ_sjekk(reg,good);
 841  Adj_EROWZ_MROWZ(good)$(sum(sec,USGN(sec,good)) - sum(fin$mapPFin('149',fin),UGFN(good,fin)) <  0) = sum(sec,USGN(sec,good)) - sum(fin$mapPFin('149',fin),UGFN(good,fin) + checktol);
 842  *Adj_EROWZ_MROWZ(good)=0;
 843  * =================                                                                                           ====================== *
 844  * ================= Export to the rest of the world       ====================== *
 845  EROWZ(reg,good)  = (sum(fin$mapPFin('149',fin),UGFN(good,fin)) + Adj_EROWZ_MROWZ(good))*indicEXP(reg,good);
 846  EROWZ_sjekk(reg,good) =  (sum(fin$mapPFin('149',fin),UGFN(good,fin)))*indicEXP(reg,good);
 847  display EROWZ;
 848   
 849   
 850  * ================= Goverment demand       ====================== *
 851  CGZ(reg,good)    = sum(fin$mapPFin('143',fin),UGFN(good,fin))*indicCONSgov(reg,good);
 852  CBUDGZ(reg)          = sum(good,CGZ(reg,good)) ;
 853   
 854  * =================          Investment                       ====================== *
 855  IZ(reg,good)     = sum(fin$mapPFin('144',fin),UGFN(good,fin))*indicINV(reg,good);
 856  ITZ(reg)             = sum(good,IZ(reg,good)) ;
 857  *IZ(sec,reg)$((sum(regg,indicINV(regg,sec)) eq 0) and sum(map(cm,sec),SAM(cm,"61")))
 858  *                = sum(map(cm,sec),SAM(cm,"61"))
 859  *                *sum(secc,IZ(secc,reg))/sum(regg,sum(secc,IZ(secc,regg))) ;
 860  display "div0 6";
 861   
 862   
 863  * =================          Changes inventories                       ====================== *
 864  gcount(good)=0;
 865  SVZ(reg,good)$(abs(sum(fin$mapPFin('145',fin),UGFN(good,fin)))<= checktol)=0;
 866  SVZ(reg,good)$(abs(sum(fin$mapPFin('145',fin),UGFN(good,fin)))>checktol) = (sum(fin$mapPFin('145',fin),UGFN(good,fin)))*( CZ(reg,good) + CGZ(reg,good)+ sum(ss,IOZ(reg,good,ss)) )
 867                    /sum(reg2,(CZ(reg2,good) + CGZ(reg2,good)+ sum(ss,IOZ(reg2,good,ss)) )) ;
 868  gcount(good)$(abs(sum(fin$mapPFin('145',fin),UGFN(good,fin)))>checktol and abs(sum(reg2,(CZ(reg2,good) + CGZ(reg2,good)+ sum(ss,IOZ(reg2,good,ss))))<=checktol)) = 6;
