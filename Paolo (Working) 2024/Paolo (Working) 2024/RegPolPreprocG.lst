 681  display mapPFin;
 682   
 683  Display "Checking balances for national SAM:" ;
 684  ** AW 26/1-15: checking whether balances are satisfied for the national SAM at all
 685  * Sales balances:
 686  * regional version: sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good) - sum(rr, TRADEZ(good,reg,rr)) ;
 687  diffXD_n(good) = sum(sec, USGN(sec,good))- sum(fin$mapPFin('149',fin),UGFN(good,fin))
 688          - (sum(fin$mapPFin('146',fin),UGFN(good,fin))-sum(fin$mapPFin('146',fin),UFGN(fin,good)));
 689  display "Sales balances", diffXD_n;
 690  * Demand balances:
 691  * regional version: diffX(reg,good) = XZ(reg,good) - MROWZ(reg,good) - sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good));
 692  diffX_n(good) =  sum(fin$mapPFin('142',fin),UGFN(good,fin))+ sum(fin$mapPFin('143',fin),UGFN(good,fin)) + sum(fin$mapPFin('144',fin),UGFN(good,fin))
 693                    + sum(fin$mapPFin('145',fin),UGFN(good,fin)) + (sum(fin$mapPFin('146',fin),UGFN(good,fin))-sum(fin$mapPFin('146',fin),UFGN(fin,good)))
 694                    + sum(sec,UGSN(good,sec)) - sum(fin$mapPFin('149',fin),UFGN(fin,good));
 695  display "Demand balances", diffX_n;
 696  * Investment balance:
 697  * regional version: investment_bal(reg) = sum(sec,INVZ(sec,reg)) + SHZ(reg)  + SGZ(reg) + SROWZ(reg)-ITZ(reg) - sum(good, SVZ(reg,good));
 698  investment_bal_n = sum((fin,sec)$mapPFin('144',fin),UFSN(fin,sec)) + sum((fin,ff)$(mapPFin('144',fin) and mapPFin('142',ff)),UFFN(fin,ff))
 699                      + sum((fin,ff)$(mapPFin('144',fin) and mapPFin('143',ff)),UFFN(fin,ff))
 700                      + (sum((fin,ff)$(mapPFin('144',fin) and mapPFin('149',ff)),UFFN(fin,ff)) - sum((fin,ff)$(mapPFin('149',fin) and mapPFin('144',ff)),UFFN(fin,ff)))
 701                      -sum((good,fin)$mapPFin('144',fin),UGFN(good,fin)) - sum((good,fin)$mapPFin('145',fin),UGFN(good,fin));
 702   
 703  display "Investment balance", investment_bal_n;
 704   
 705  * Global trade balance:
 706  * regional version: trade_bal_global(reg) = sum(good,EROWZ(reg,good)) + sum((good,rr),TRADEZ(good,reg,rr)) + sum(good,TMXZ(reg,good)) -  TRHROWZ(reg) +  TRROWZ(reg) + SROWZ(reg)
 707  *  -  sum(good,MROWZ(reg,good)) - sum((good,rr),TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good));
 708  *tradebal_glob(reg)=sum(good,mSAM(reg,good,'trade'))
 709  *      + (sum(fin$mapPFin('142',fin),mSAM(reg,fin,'trade')-mSAM(reg,'trade',fin)))
 710  *      + (sum(fin$mapPFin('143',fin),mSAM(reg,fin,'trade') - mSAM(reg,'trade',fin)))
 711  *      + (sum(fin$mapPFin('144',fin),mSAM(reg,fin,'trade') - mSAM(reg,'trade',fin)))
 712  *      - sum(good,mSAM(reg,'trade',good)) ;
 713   
 714  trade_bal_global_n = sum((fin,good)$mapPFin('149',fin),UGFN(good,fin))
 715        + (sum((fin,ff)$(mapPFin('142',fin) and mapPFin('149',ff)),UFFN(fin,ff)-UFFN(ff,fin)))
 716        + (sum((fin,ff)$(mapPFin('143',fin) and mapPFin('149',ff)),UFFN(fin,ff) - UFFN(ff,fin)))
 717        + (sum((fin,ff)$(mapPFin('144',fin) and mapPFin('149',ff)),UFFN(fin,ff) - UFFN(ff,fin)))
 718        - sum((fin,good)$mapPFin('149',fin),UFGN(fin,good)) ;
 719   
