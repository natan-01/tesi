 410  *UJ 22/03   Creating the share between public and local consumption
 411  parameter dgrp_2(good)
 412  distrgood_share_public(reg,good);
 413   
 414   
 415  dgrp_2(good)=sum((sec,reg2),(distrsec_public(reg2,sec)+ distrsec_local(reg
      2,sec))*USGN(sec,good));
 416   
 417   
 418   
 419  display   distrsec_public, distrsec_local;
 420   
 421  loop(good,
 422     if(dgrp_2(good),
 423        distrgood_public(reg,good)=sum(sec,distrsec_public(reg,sec)*USGN(sec
      ,good));
 424     );
 425  );
 426   
 427   
 428  loop(good,
 429     if(dgrp_2(good),
 430        distrgood_local(reg,good)=sum(sec,distrsec_local(reg,sec)*USGN(sec,g
      ood));
 431     );
 432  );
 433   
 434   
 435  distrgood_share_public(reg,good)$(distrgood_public(reg,good) +  distrgood_
      local(reg,good))=  distrgood_public(reg,good)/(distrgood_public(reg,good) 
      +  distrgood_local(reg,good));
 436   
 437   
 438  display distrgood_share_public;
