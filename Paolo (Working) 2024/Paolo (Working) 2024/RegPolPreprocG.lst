 886  display CZ, CGZ, IOZ;
 887  TMXZ(reg,good)$(sum(rr,CZ(rr,good)+ CGZ(rr,good) + sum(sec,IOZ(rr,good,sec)))) =sum(fin$mapPFin('146',fin),UGFN(good,fin))
 888                    *(CZ(reg,good) + CGZ(reg,good)+ sum(sec,IOZ(reg,good,sec)))/sum(rr,CZ(rr,good)+ CGZ(rr,good) + sum(sec,IOZ(rr,good,sec)) ) ;
 889  TMTZ(reg)       = sum(good,TMXZ(reg,good));
 890  display TMTZ, TMXZ;
 891  * =================       Fiks for balancing trade and transport margins                                 ====================== *
 892  * Adjusting this code to make the trade and transport margins balanced
 893  * AW 18/12 - checking division by zero
 894  display "div0 8";
 895  gcount(good)=0;
