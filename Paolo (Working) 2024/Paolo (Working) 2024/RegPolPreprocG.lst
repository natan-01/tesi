 781  *Split capital into two parts - investments and operating surplus
 782  *the old version of KZ(sec,reg)           =  sum(fin$mapPFin('135',fin),UFSN(fin,sec))*indicLAB(reg,sec) ;
 783  display "div0 2";
 784   
 785  * AW 16/12  - finn ut hvilke sec det gjelder
 786  rccount(reg,sec)=0;
 787  KZ(sec,reg)$(abs(capital(reg,sec))<=checktol)=0;
 788  KZ(sec,reg)$(abs(capital(reg,sec))>checktol) = capital(reg,sec)*(sum(fin$mapPFin('135',fin),UFSN(fin,sec)))/ (sum(fin$mapPFin('144',fin), UFSN(fin,sec)) + sum(fin$mapPFin('135',fin),UFSN(fin,sec))) ;
 789  rccount(reg,sec)$(abs(capital(reg,sec))>checktol and abs(sum(fin$mapPFin('144',fin), UFSN(fin,sec)) + sum(fin$mapPFin('135',fin),UFSN(fin,sec)))<=checktol) =2;
 790   
