 504  USFN(sec,fin)   =    USFN(sec,fin)/scal;
 505  UFGN(fin,good)  =    UFGN(fin,good)/scal;
 506  UFSN(fin,sec)   =    UFSN(fin,sec)/scal;
 507  UFFN(fin,ff)    =    UFFN(fin,ff)/scal;
