      y mapped to user goods and regions
 240         distrPRegAnvN(reg,sec) !! normalised usage disaggregation key mappe
      d to user sectors
 241         distrPCountyincome(county) !! income (consumption) disaggregation
 242         distrPCountyincome_sec(county,sec) !! income (consumption) disaggre
      gation
 243         distrsecRegincomeN(reg,sec)  !! normalised supply disaggregation ke
      y mapped to user goods and regions
 244         distrGoodRegincomeN(reg,good)  !! normalised supply disaggregation 
      key mapped to user goods and regions
 245         distrsec_public(reg,sec)  !! local public key
 246         distrsec_local(reg,sec)  !! local public key
 247         distrGood_public(reg,good)  !! local public key
 248         distrGood_local(reg,good)  !! local public key
 249         distrPCountyincomeN(county) !! normalised income (consumption) disa
      ggregation
 250         distrPRegincomeN(reg)        !! normalised income (consumption) agg
      regation mapped to regions
 251         sumpsg(sec)       !! AW 16-12
 252         ;
 253   
 254  * nation-wide pattern (ratio) of usage of commodities by sectors (both on 
      user case level)
 255  *distrGoodUseSAM(good,sec) = sum((Pgood,Psec)$(mapPGood(Pgood,good) and ma
      pPSec(Psec,sec)),PGS(Pgood,Psec)) / sum((Pgood,Psec)$mapPGood(Pgood,good),
      PGS(Pgood,Psec));
 256  * ... and of supply of commodities by sectors
 257   
 258  * AW 16/12
 259  sumpsg(sec)= sum((Psec,Pgood)$mapPSec(Psec,sec),PSG(Psec,Pgood));
 260  *display sumpsg;
 261   
 262  loop(sec,
 263   if (sumpsg(sec),
 264      distrGoodSupplySAM(sec,good)=  sum((Psec,Pgood)$(mapPGood(Pgood,good) 
      and mapPSec(Psec,sec)),PSG(Psec,Pgood)) / sumpsg(sec);
 265   else
 266      distrGoodSupplySAM(sec,good) = 1/card(good);
 267  );
 268    );
 269   
 270  *distrGoodSupplySAM(sec,good)=  sum((Psec,Pgood)$(mapPGood(Pgood,good) and
       mapPSec(Psec,sec)),PSG(Psec,Pgood)) / sum((Psec,Pgood)$mapPSec(Psec,sec),
      PSG(Psec,Pgood));
 271   
 272   
 273   
 274  *-------------------------------------------------------
 275  * convert SAM submatrices to user sectors & products & fin
 276  UGFN(good,fin)=sum((Pgood,Pfin)$(mapPGood(Pgood,good) and mapPFin(Pfin,fin
      )), PGF(Pgood,Pfin));
 277  USFN(sec,fin)=sum((Psec,Pfin)$(mapPSec(Psec,sec) and mapPFin(Pfin,fin)), P
      SF(Psec,Pfin));
 278  UFFN(ff,fin)=sum((p_ff,Pfin)$(mapPFin(p_ff,ff) and mapPFin(Pfin,fin)), PFF
      (p_ff,Pfin));
 279  UFGN(fin,good)=sum((Pfin,Pgood)$(mapPFin(Pfin,fin) and mapPGood(Pgood,good
      )), PFG(Pfin,Pgood));
 280  UFSN(fin,sec)=sum((Pfin,Psec)$(mapPFin(Pfin,fin) and mapPSec(Psec,sec)), P
      FS(Pfin,Psec));
 281  * USGN and UGSN are needed for composing the national SAM
 282  UGSN(good,sec)= sum((Pgood,Psec)$(mapPGood(Pgood,good) and mapPSec(Psec,se
      c)),PGS(Pgood,Psec));
 283  USGN(sec,good)= sum((Pgood,Psec)$(mapPSec(Psec,sec) and mapPGood(Pgood,goo
      d)),PSG(Psec,Pgood));
 284   
 285  * mapSecGood indicates whether good is supplied by sec
