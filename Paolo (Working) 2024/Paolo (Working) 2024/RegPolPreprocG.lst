 938           = TAXCZ(good)*( CZ(reg,good)+ CGZ(reg,good) + IZ(reg,good) + sum(sec, IOZ(reg,good,sec)) )/
 939          ( sum(reg2, CZ(reg2,good)+ CGZ(reg2,good) + IZ(reg2,good) ) + sum((reg2,ss), IOZ(reg2,good,ss)) );
 940  gcount(good)$(abs(TAXCZ(good))>checktol and abs(sum(reg2, CZ(reg2,good)+ CGZ(reg2,good) + IZ(reg2,good) ) + sum((reg2,ss), IOZ(reg2,good,ss)) <=checktol)) =9;
