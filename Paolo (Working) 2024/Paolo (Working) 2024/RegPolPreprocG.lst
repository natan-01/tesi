 992  MROWZ(reg,good)$(abs(sum(fin$mapPFin('149',fin),UFGN(fin,good)+ Adj_EROWZ_MROWZ(good)))>checktol) = sum(fin$mapPFin('149',fin),UFGN(fin,good)+ Adj_EROWZ_MROWZ(good))*XZ(reg,good)/sum(rr,XZ(rr,good));
 993  gcount(good)$(abs(sum(fin$mapPFin('149',fin),UFGN(fin,good)+ Adj_EROWZ_MROWZ(good)))>checktol and abs(sum(rr,XZ(rr,good))<=checktol))=10;
