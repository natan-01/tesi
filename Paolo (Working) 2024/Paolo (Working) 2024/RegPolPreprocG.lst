 393  * UJ 01/02
 394  parameter dgrp_1(good);
 395  dgrp_1(good)=sum((sec,reg2),distrsecRegincomeN(reg2,sec)*USGN(sec,good));
 396   
 397  loop(good,
 398     if(dgrp_1(good),
 399        distrGoodRegincomeN(reg,good)=sum(sec,distrsecRegincomeN(reg,sec)*US
      GN(sec,good))/sum((sec,reg2),distrsecRegincomeN(reg2,sec)*USGN(sec,good));
 400     else
 401        distrGoodRegincomeN(reg,good)=1/card(reg);
 402     );
 403  );
