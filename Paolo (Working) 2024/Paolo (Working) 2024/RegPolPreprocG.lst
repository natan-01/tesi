1207   
1208  *EQentropy.. entropy =E= sum((sec,reg)$SUM_o(sec,reg),SUM_oV(sec,reg)
1209  *            *log(SUM_oV(sec,reg)/SUM_o(sec,reg)))
1210  *            + sum((sec,reg)$SUM_d(sec,reg),SUM_dV(sec,reg)
1211  *            *log(SUM_dV(sec,reg)/SUM_d(sec,reg)));
1212   
1213  EQentropy.. entropy =E= sum((good,reg,rr)$(abs(XDDE_o(good,reg,rr)) > checktol),XDDE_oV(good,reg,rr)
1214              *log(XDDE_oV(good,reg,rr)/XDDE_o(good,reg,rr)))
1215              + sum((good,reg,rr)$(abs(XDDE_d(good,reg,rr))>checktol),XDDE_dV(good,reg,rr)
1216             *log(XDDE_dV(good,reg,rr)/XDDE_d(good,reg,rr)));
1217   
1218  EQentropy2.. entropy =E= 1;
1219   
1220  Model entropy_min /EQ1,EQ2,EQ3,EQ4,EQ5,EQentropy2/ ;
1221   
1222  *** give some start values
1223  XDDE_oV.L(good,reg,rr)  =  XDDE_o(good,reg,rr) ;
1224  XDDE_dV.L(good,rr,reg)  =  XDDE_d(good,rr,reg) ;
1225  SUM_oV.L(reg,good)      =  SUM_o(reg,good)       ;
1226  SUM_dV.L(reg,good)      =  SUM_d(reg,good)       ;
1227   
1228  XDDE_oV.LO(good,reg,rr) =  0.000001*XDDE_o(good,reg,rr) ;
1229  XDDE_dV.LO(good,rr,reg) =  0.000001*XDDE_d(good,rr,reg) ;
1230  SUM_oV.LO(reg,good)       =  0.000001*SUM_o(reg,good)       ;
1231  SUM_dV.LO(reg,good)       =  0.000001*SUM_d(reg,good)       ;
1232   
1233  XDDE_oV.FX(good,reg,rr)$(abs(XDDE_o(good,reg,rr))< checktol) =  0 ;
1234  XDDE_dV.FX(good,rr,reg)$(abs(XDDE_d(good,rr,reg))<checktol) =  0 ;
1235  SUM_oV.FX(reg,good)$(abs(SUM_o(reg,good))<checktol)         =  0       ;
1236  SUM_dV.FX(reg,good)$(abs(SUM_d(reg,good)) < checktol)           =  0      ;
1237   
1238  option nlp=PATHNLP;
1239  Solve entropy_min using nlp minimizing entropy;
1240   
1241  Display XDDE_oV.L ;
1242  *** AW 23/1-15
1243  *loop ((good,reg,rr),
1244  *   if ((XDDE_oV.L(good,reg,rr) lt checktol),
1245  *        abort "check XDDE_o(good,reg,rr)"
1246  *   );
1247  *);
1248   
1249   
1250  Display XDDE_dV.L ;
1251  *** AW 23/1-15
1252  *loop ((good,reg,rr),
1253  *   if ((XDDE_dV.L(good,reg,rr) lt checktol),
1254  *        abort "check XDDE_d(good,reg,rr)"
1255  *   );
1256  *);
1257   
1258  Parameter diffXD(reg,good),diffX(reg,good),indicator_sec(good),diffXD2(reg,good) ;
1259   
1260  diffXD(reg,good)$(abs(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))>checktol)
1261                 = scal*(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good) ) -
1262                 sum(rr, XDDE_oV.L(good,reg,rr)) ;
1263   
1264  diffX(reg,good)$(abs(XZ(reg,good) - MROWZ(reg,good))>checktol)
1265                 = scal*(XZ(reg,good)-MROWZ(reg,good) ) -
1266                 sum(rr, XDDE_dV.L(good,rr,reg) ) ;
1267   
1268  indicator_sec(good)= max(sum(reg,diffXD(reg,good)),sum(reg,diffX(reg,good))) ;
1269   
1270  Display XDDE_oV.L, diffXD, diffX,indicator_sec, entropy.L ;
1271   
1272   
1273  * Transport margins
1274  TAXCZR(reg,rr,good) =  XDDE_oV.L(good,reg,rr)*taxcz(good)/scal;
1275  TMCRZ(reg,rr,good) =  XDDE_oV.L(good,reg,rr)*transpm(good)/scal;
1276   
1277  display  TAXCZR, TMCRZ;
1278   
1279  * Interreginonal trade
1280  TRADEZ(good,reg,rr) = XDDE_oV.L(good,reg,rr)/scal ;
1281  TRADEZ_f(good,rr) = sum(reg,XDDE_oV.L(good,reg,rr)) ;
1282  TRADEZ_t(good,reg) = sum(rr,XDDE_oV.L(good,reg,rr)) ;
1283   
1284  * AW 2/12: bruk XDDZ direkte istf. XDZ og mapSecGood
1285  *diffXD(reg,good) = sum(sec$mapSecGood(sec,good),XDZ(sec,reg))- EROWZ(reg,good) - sum(rr, TRADEZ(good,reg,rr)) ;
1286  diffXD(reg,good) = sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good) - sum(rr, TRADEZ(good,reg,rr)) ;
1287   
1288  diffX(reg,good) = XZ(reg,good) - MROWZ(reg,good)  -
1289  *               sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good)+ TAXCZR(rr,reg,good))  ;
1290                 sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good))  ;
1291   
1292  Parameter TMCRZ_f(reg,good),  TAXCZR_f(reg,good);
1293   
1294  TMCRZ_f(reg,good) = sum(rr, TMCRZ(rr,reg,good))  ;
1295  TAXCZR_f(reg,good)  = sum(rr,TAXCZR(rr,reg,good))  ;
1296   
1297  *The old version with trade and transportmarginsincluded included
1298  *sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good))  ;
1299   
1300  display XZ,diffXD,diffX,TMCRZ_f,TAXCZR_f,TRADEZ_f;
1301   
1302  ** AW 30/9-14: this is just calculated, never written to mSAM or used further...
1303  XXDZ(reg,good)  =  sum(sec,XDDZ(reg,sec,good)) - sum(rr,TRADEZ(good,reg,rr)) - EROWZ(reg,good) ;
1304   
1305  *Execute_unload "sjekk"   TMCZ_R,  TMCRZ;
1306  display CZ_old, CZ;
1307   
1308  * 4) build one common regionalised SAM
INCLUDE    C:\Users\natis\Downloads\Paolo (Working) 2024\Paolo (Working) 2024\includes\write_msam.gms
1310  display  " (4) combine the single parameters to regionalised SAMs in mSAM"
1311  display  "     also, write out interregional trade data and transport margins"
1312   
1313   
1314  Parameters
1315      mSAM(reg,*,*)
1316      mTradeData(good,*,*)
1317      mTradeMargins(good,reg,reg)
1318  ;
1319   
1320  mSAM(reg,good,sec)= IOZ_old(reg,good,sec);
1321   
1322   
1323  * =================                                   ========================== *
1324  *When writing XDDZ to MSAM we have to take out some values for R6 (Sokkelen) because of small numbers and this is creating errors in the MPSGE-kode
1325  scalars
1326   checktol_2 /1e-08/
1327   checktol_3 /1e-20/
1328  ;
1329   
1330  *mSAM(reg,sec,good)=XDDZ(reg,sec,good)
1331  mSAM(reg,sec,good)=XDDZ(reg,sec,good);
1332  *$(not XDDZ(reg,sec,good)<checktol_3);
1333  * =================                                   ========================== *
1334   
1335  mSAM(reg,fin,sec)$mapPFin('131',fin) = LZ(sec,reg);
1336  mSAM(reg,fin,sec)$mapPFin('135',fin) = KZ(sec,reg);
1337   
1338   
1339   
1340  mSAM(reg,good,fin)$mapPFin('142',fin) = CZ_old(reg,good);
1341  mSAM(reg,good,fin)$mapPFin('143',fin) = CGZ_old(reg,good);
1342  mSAM(reg,good,fin)$mapPFin('144',fin) = IZ_old(reg,good);
1343  mSAM(reg,good,fin)$mapPFin('145',fin) = SVZ(reg,good);
1344   
1345   
1346   
1347  mTradeData(good,reg,reg2) = TRADEZ(good,reg,reg2);
1348  *$(not TRADEZ(good,reg,reg2)<checktol_3);
1349   
1350  mTradeData(good,reg,fin)$mapPFin('149',fin)= EROWZ(reg,good) ;
1351  *$(not EROWZ(reg,good)<checktol_3);
1352  mTradeData(good,fin,reg)$mapPFin('149',fin) = MROWZ(reg,good)  ;
1353  *$(not MROWZ(reg,good)<checktol_3);
1354   
1355   
1356   
1357  * Outgoing trade is the sum of TRADEZ (trade to other regions) and EROWZ (export to RestOfWorld)
1358  mSAM(reg,good,'trade')= EROWZ(reg,good) + sum(reg2$(ord(reg2)<>ord(reg)),TRADEZ(good,reg,reg2)) ;
1359  *$(not TRADEZ(good,reg,reg2)<checktol_3)) ;
1360  * Import is the sum of TRADEZ (trade from other regions) and MROWZ (import from RestOfWorld)
1361  mSAM(reg,'trade',good)= MROWZ(reg,good) + sum(reg2$(ord(reg2)<>ord(reg)),TRADEZ(good,reg2,reg) );
1362  *$(not TRADEZ(good,reg,reg2)<checktol_3)) ;
1363   
1364  mSAM(reg,good,fin)$mapPFin('146',fin) =TMXZ(reg,good);
1365  display TMXZ;
1366  ** 27/10: Usikker om det skal summeres over fra- eller til-dimensjon
1367  mSAM(reg,fin,good)$mapPFin('146',fin)= sum(reg2,TMCRZ(reg2,reg,good));
1368  mTradeMargins(good,reg,reg2)=TMCRZ(reg,reg2,good) ;
1369  *$(not TMCRZ(reg,reg2,good)<checktol_3);;
1370   
1371   
1372   
1373  mSAM(reg,fin,ff)$(mapPFin('143',fin) and mapPFin('134',ff))=TTYZ(reg);
1374  mSAM(reg,fin,ff)$(mapPFin('142',fin) and mapPFin('143',ff))=TRANSFZ(reg);
1375  mSAM(reg,fin,good)$mapPFin('138',fin)= sum(reg2,TAXCZR(reg2,reg,good));
1376  mSAM(reg,fin,sec)$mapPFin('137',fin) = TAXPZ(sec,reg);
1377  mSAM(reg,fin,sec)$mapPFin('144',fin) = INVZ(sec,reg);
1378  mSAM(reg,fin,ff)$(mapPFin('144',fin) and mapPFin('142',ff)) = SHZ(reg);
1379  mSAM(reg,fin,ff)$(mapPFin('144',fin) and mapPFin('143',ff)) = SGZ(reg);
1380   
1381   
1382   
1383  * Adding zeros where we don't have any values
1384  mSAM(reg,good,sec)$(not mSAM(reg,good,sec))=0;
1385  mSAM(reg,sec,good)$(not mSAM(reg,sec,good))=0;
1386   
1387  **
1388  mSAM(reg,fin,sec)$(not mSAM(reg,fin,sec))=0;
1389  mSAM(reg,fin,ff)$(not mSAM(reg,fin,ff))=0;
1390  mSAM(reg,fin,good)$(not mSAM(reg,fin,good))=0;
1391  mSAM(reg,good,'trade')$(not mSAM(reg,good,'trade'))=0;
1392  mSAM(reg,'trade',good)$(not mSAM(reg,'trade',good))=0;
1393   
1394  * Adding zeros where we don't have any values
1395  mTradeData(good,reg,reg2)$(not mTradeData(good,reg,reg2))=0;
1396  mTradeData(good,reg,fin)$(not mTradeData(good,reg,fin) and mapPFin('149',fin))=0;
1397  mTradeData(good,fin,reg)$(not mTradeData(good,fin,reg)and mapPFin('149',fin))=0;
1398   
1399  *Adding zeros where we don't have any values
1400  mTradeMargins(good,reg,reg2)$(not mTradeMargins(good,reg,reg2))=0;
1401   
1402   
1403   
1404  * 5) Balance, checks etc. for the regional matrices
INCLUDE    C:\Users\natis\Downloads\Paolo (Working) 2024\Paolo (Working) 2024\includes\CheckBalance.gms
1406  display  "     Perform some balancing checks" ;
1407   
1408  ** Balance / calculate residual cells
1409  mSAM(reg,fin,ff)$(mapPFin('134',fin) and mapPFin('142',ff)) = TTYZ(reg);
1410  mSAM(reg,fin,ff)$(mapPFin('142',fin) and mapPFin('131',ff)) = sum(sec,LZ(sec,reg));
1411  mSAM(reg,fin,ff)$(mapPFin('142',fin) and mapPFin('135',ff)) = sum(sec,KZ(sec,reg));
1412  mSAM(reg,fin,ff)$(mapPFin('143',fin) and mapPFin('137',ff)) = sum(sec,TAXPZ(sec,reg));
1413  mSAM(reg,fin,ff)$(mapPFin('143',fin) and mapPFin('138',ff)) = sum((rr,good),TAXCZR(rr,reg,good));
1414  mSAM(reg,fin,ff)$(mapPFin('145',fin) and mapPFin('144',ff)) = sum(good,SVZ(reg,good));
1415  * SROWZ:   AW 6/10 Calculate as balancing item from investment balance (or row vs. column sum for '144' ;-) )
1416  SROWZ(reg) = ITZ(reg)+sum(good,SVZ(reg,good))
1417                -sum(sec,INVZ(sec,reg))-SHZ(reg)-SGZ(reg);
1418  *display SROWZ;
1419   
1420  ** AW try 20/10 - alternative calculation; same as in balancing of national SAM
1421  ** calculate also TRHROW(reg) here as residual, as in national SAM
1422  ** -- is global trade balance satisfied then? (doubt it)
1423  * Balanserer GOVERNMENT
1424  TRROWZ(reg)=sum(good,CGZ_old(reg,good))+TRANSFZ(reg)+SGZ(reg)-TTYZ(reg)- sum(sec,TAXPZ(sec,reg))- sum((rr,good),TAXCZR(rr,reg,good));
1425  *             -TTYZ(reg)- sum((fin,ff)$(mapPFin('143',fin) and mapPFin('137',ff)),mSAM(reg,fin,ff))- sum((fin,ff)$(mapPFin('143',fin) and mapPFin('138',ff)),mSAM(reg,fin,ff));
1426   
1427  * Balanserer HOUSEHOLD
1428  TRHROWZ(reg) = sum(sec,LZ(sec,reg))+sum(sec,KZ(sec,reg))+TRANSFZ(reg)-sum(good,CZ_old(reg,good))-TTYZ(reg)-SHZ(reg);
1429   
1430  * OBS: need to write in correct cell, depending on sign (received from or transferred to)
1431  loop(reg,
1432     if(SROWZ(reg)>0,
1433        mSAM(reg,fin,'trade')$mapPFin('144',fin)=SROWZ(reg);
1434     else
1435        mSAM(reg,'trade',fin)$mapPFin('144',fin)=-SROWZ(reg);
1436     );
1437     if (TRROWZ(reg)>0,
1438        mSAM(reg,fin,'trade')$mapPFin('143',fin) = TRROWZ(reg);
1439     else
1440        mSAM(reg,'trade',fin)$mapPFin('143',fin)= -TRROWZ(reg);
1441     );
1442     if (TRHROWZ(reg) > 0,
1443        mSAM(reg,'trade',fin)$mapPFin('142',fin) = TRHROWZ(reg);
1444     else
1445        mSAM(reg,fin,'trade')$mapPFin('142',fin) = -TRHROWZ(reg);
1446     );
1447  );
1448   
1449  **********    ===============================       DATA CHECKS ======================================     *********
1450   
1451  parameters
1452    diXD(reg,good)
1453    diX(reg,good)
1454    trade_bal(reg,good)
1455    investment_bal(reg) balance of savings and investments
1456    trade_bal_global(reg) global trade balance
1457    salebal(reg,good)
1458    demandbal(reg,good)
1459    tradebal(reg)
1460    invbal(reg)
1461    tradebal_glob(reg)
1462  * to check AW 28/10:
1463    householdbal(reg)
1464    govbal(reg)
1465  ;
1466   
1467   
1468  * a) Sales in a region = domestic supply + exports to RoW and other regions
1469  * AW 2/12: bruk XDDZ direkte istf. XDZ og mapSecGood
1470  *diXD(reg,good) = sum(sec$mapSecGood(sec,good),XDZ(sec,reg)) - sum(rr, TRADEZ(good,reg,rr))-  EROWZ(reg,good) ;
1471  diXD(reg,good) = sum(sec,XDDZ(reg,sec,good)) - sum(rr, TRADEZ(good,reg,rr))-  EROWZ(reg,good) ;
1472  salebal(reg,good) = sum(sec,mSAM(reg,sec,good))-mSAM(reg,good,'trade')-mTradeData(good,reg,reg);
1473  *last mSAM term does not include intraregional trade, TRADEZ does -> need also mTradeData for intraregional
1474  display diXD,salebal;
1475   
1476  * b) Demand in a region = import from ROW and other regions (as products or trade & transport margins)
1477  diX(reg,good) = XZ(reg,good)-MROWZ(reg,good) - sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good)+ TAXCZR(rr,reg,good) ) ;
1478  *The version with trade and transportmargins included
1479  *diX(reg,good) = XZ(reg,good)-MROWZ(reg,good) - sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good)) ;
1480   
1481  ** AW 27/10: the first 3 lines are XZ
1482  demandbal(reg,good) = sum(sec,mSAM(reg,good,sec))+sum(fin$mapPFin('142',fin),mSAM(reg,good,fin))
1483             + sum(fin$mapPFin('143',fin),mSAM(reg,good,fin))+sum(fin$mapPFin('144',fin),mSAM(reg,good,fin))
1484             + sum(fin$mapPFin('145',fin),mSAM(reg,good,fin))+sum(fin$mapPFin('146',fin),mSAM(reg,good,fin))
1485  *           -mSAM(reg,'trade',good)-mTradeData(good,reg,reg)-sum(rr,mTradeMargins(good,rr,reg));
1486             -mSAM(reg,'trade',good)-mTradeData(good,reg,reg)-sum(fin$mapPFin('146',fin),mSAM(reg,fin,good));
1487  * last line:
1488  * use mTradeData as mSAM does *not* contain intraregional trade flows
1489   
1490  trade_bal(reg,good) = diXD(reg,good) - diX(reg,good) ;
1491  display diX, demandbal, trade_bal;
1492   
1493  *loop((reg,good),
1494  *   if (abs(salebal(reg,good)) gt checktol,
1495  *          abort "Sales are not balanced "
1496  *   );
1497  *   if (abs(demandbal(reg,good)) gt checktol,
1498  *          abort "Demands are not balanced "
1499  *   );
1500  *);
1501   
1502  * c) Balance savings and investments
1503  * Ulf's version:
1504  investment_bal(reg) = sum(sec,INVZ(sec,reg)) + SHZ(reg)  + SGZ(reg) + SROWZ(reg)
1505  *- sum(good,IZ(reg,good)) - sum(good, SVZ(reg,good));
1506  -ITZ(reg) - sum(good, SVZ(reg,good));
1507   
1508  invbal(reg)=sum((fin,sec)$mapPFin('144',fin),mSAM(reg,fin,sec))+sum((fin,ff)$(mapPFin('144',fin) and mapPFin('142',ff)),mSAM(reg,fin,ff))
1509              +sum((fin,ff)$(mapPFin('144',fin) and mapPFin('143',ff)),mSAM(reg,fin,ff))+ sum(fin$mapPFin('144',fin),(mSAM(reg,fin,'trade')-mSAM(reg,'trade',fin)))
1510  * last two terms:  see calculation of SROWZ in TradeGravity.gms and Olga's model - to get sign right
1511  **            -sum(good,mSAM(reg,good,fin)) )-sum((good,fin)$mapPFin('145',fin),mSAM(reg,good,fin));
1512              -ITZ(reg)-sum((good,fin)$mapPFin('145',fin),mSAM(reg,good,fin));
1513   
1514  Display  investment_bal,invbal ;
1515   
1516  * d) Global trade balance:
1517  * incoming monetary flows (exports) = outgoing mon. flows (imports)
1518  * Ulf's version:
1519  trade_bal_global(reg) =
1520  * Incoming monetary flows (exports)
1521    sum(good,EROWZ(reg,good)) + sum((good,rr),TRADEZ(good,reg,rr)) + sum(good,TMXZ(reg,good))
1522  *  sum(good,EROWZ(reg,good))
1523   -  TRHROWZ(reg) +  TRROWZ(reg) + SROWZ(reg)
1524  ** AW 20/10: har minus foran TRHROW pga. fortegn til denne (står i rad istf. kolonne, ref. nasj. SAM)
1525  * Outgoing monetary flows (imports)
1526    -  sum(good,MROWZ(reg,good)) - sum((good,rr),TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good));
1527  *  -  sum(good,MROWZ(reg,good));
1528   
1529  tradebal_glob(reg)=sum(good,mSAM(reg,good,'trade'))
1530        + (sum(fin$mapPFin('142',fin),mSAM(reg,fin,'trade')-mSAM(reg,'trade',fin)))
1531        + (sum(fin$mapPFin('143',fin),mSAM(reg,fin,'trade') - mSAM(reg,'trade',fin)))
1532        + (sum(fin$mapPFin('144',fin),mSAM(reg,fin,'trade') - mSAM(reg,'trade',fin)))
1533        - sum(good,mSAM(reg,'trade',good)) ;
1534  *mSAM terms for EROW / MROW do not include intraregional trade, TRADEZ does -> need also mTradeData for intraregional
1535  *But these cancel each other out (first & last line)
1536  Display trade_bal_global,tradebal_glob;
1537   
1538  * AW 28/10 to check
1539  householdbal(reg)= TRHROWZ(reg)- (sum(sec,LZ(sec,reg))+sum(sec,KZ(sec,reg))+TRANSFZ(reg)-sum(good,CZ_old(reg,good))-TTYZ(reg)-SHZ(reg));
1540  display householdbal;
1541  govbal(reg)=  TRROWZ(reg)-(sum(good,CGZ_old(reg,good))+TRANSFZ(reg)+SGZ(reg)-TTYZ(reg)- sum(sec,TAXPZ(sec,reg))- sum((rr,good), TAXCZR(rr,reg,good)));
1542  display govbal;
1543   
1544   
1545  **AW 20/10
1546  *loop(reg,
1547  *   if (abs(investment_bal(reg)) gt checktol ,
1548  *          abort "There is no global investment balance"
1549  *   );
1550  *  if (abs(trade_bal_global(reg)) gt checktol ,
1551  *         abort "There is no global trade balance"
1552  *  );
1553  *);
1554   
1555  ** ====================== Calculate 'tot' row and column sums and add to mSAM
1556  *** AW 13/10: unsure if this is needed at all
1557  * 'trade' includes all export from the region (to other regions and to RoW)
1558  * this cell is not included in Fin vector, replaces RoW -> must add separately
1559  mSAM(reg,good,'tot')=sum(gg,mSAM(reg,good,gg))+sum(sec,mSAM(reg,good,sec))+sum(fin,mSAM(reg,good,fin))+mSAM(reg,good,'trade');
1560  mSAM(reg,sec,'tot')=sum(good,mSAM(reg,sec,good))+sum(ss,mSAM(reg,sec,ss))+sum(fin,mSAM(reg,sec,fin))+mSAM(reg,sec,'trade');
1561  mSAM(reg,fin,'tot')=sum(good,mSAM(reg,fin,good))+sum(sec,mSAM(reg,fin,sec))+sum(ff,mSAM(reg,fin,ff))+mSAM(reg,fin,'trade');
1562  mSAM(reg,'trade','tot')=sum(good,mSAM(reg,'trade',good))+sum(sec,mSAM(reg,'trade',sec))+sum(ff,mSAM(reg,'trade',ff))+mSAM(reg,'trade','trade');
1563  * 'trade' includes all import into the region (from other regions and from RoW)
1564  * this cell is not included in Fin vector -> must add separately
1565  mSAM(reg,'tot',good)=sum(gg,mSAM(reg,gg,good))+sum(sec,mSAM(reg,sec,good))+sum(fin,mSAM(reg,fin,good))+mSAM(reg,'trade',good);
