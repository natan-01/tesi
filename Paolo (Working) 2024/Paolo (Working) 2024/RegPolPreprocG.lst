      *trade_reg(reg,reg2) =sum((from_sec,to_sec, county, county2)$(mapCMtoReg(county,reg) and mapCMtoReg(county2,reg2)),trade_sec(county,county2,from_sec,to_sec) ) ;
       
       
      display trade_sec;
