 321  display distrPCountyProd;
 322   
 323   
 324  loop(sec,
 325       if(sum(cc, distrPCountyProd('99',sec)>0),
 326              if ((distrPCountyProd('99',sec)/sum(cc, distrPCountyProd(cc,se
      c))<checktol),
 327                      distrPCountyProd('99',sec)=0;
 328               );
 329       );
 330   
 331  );
 332   
 333  display "Mark 1"
 334  * normalise keys and map from county to regional level
 335  loop(sec,
 336     if (sum(cc, distrPCountyProd(cc,sec)),
 337       distrPRegProdN(reg,sec) = sum(county$mapCMtoReg(county,reg),distrPCou
      ntyProd(county,sec))/sum(cc, distrPCountyProd(cc,sec));
 338     else
 339       distrPRegProdN(reg,sec)=1/card(reg);
 340      );
 341     if (sum(cc,distrPCountyAnv(cc,sec)),
 342        distrPRegAnvN(reg,sec) = sum(county$mapCMtoReg(county,reg),distrPCou
      ntyAnv(county,sec))/sum(cc, distrPCountyAnv(cc,sec));
 343     else
 344        distrPRegAnvN(reg,sec)=1/card(reg);
 345     );
 346  );
 347  display distrPRegProdN, mapCMtoReg;
 348  display "Mark 2"
 349  * The reginalization with no sector dimension
 350  if(sum(cc,distrPCountyincome(cc)),
