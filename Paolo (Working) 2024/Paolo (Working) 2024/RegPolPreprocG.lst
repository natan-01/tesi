1000  display MROWZ;
1001   
1002  *This is the gravity formulation
1003  *---estimation of the interregional trade flows
1004  Parameters
1005  XDDE_o(good,reg,reg) initial split according to origin indic
1006  XDDE_d(good,reg,reg) initial split according to destination split
1007  SUM_o(reg,good)
1008  SUM_d(reg,good)
1009  cons_check(good,reg,reg) consistency check
1010  ;
1011   
1012  *This formulation is based on distance *
1013  *XDDE_o(sec,reg,regg) = (XDZ(sec,reg)- EROWZ(sec,reg) )*indic_trade2(reg,regg,sec) ;
1014  *XDDE_d(sec,regg,reg) = (XZ(sec,reg) -  MROWZ(sec,reg))*indic_trade3(regg,reg,sec) ;
1015   
1016  * AW 16/12 + 18/12
1017  display "div0 11";
1018  rgcount(reg,good)=0;
1019  XDDE_o(good,reg,reg2)$((sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))<=checktol)=0;
1020  XDDE_o(good,reg,reg2)$((sum(rr,(XZ(rr,good)-MROWZ(rr,good))))>checktol) = scal*(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))*(XZ(reg2,good) - MROWZ(reg2,good))
1021                         /sum(rr,(XZ(rr,good)-MROWZ(rr,good)));
1022  rgcount(reg,good)$((sum(sec,XDDZ(reg,sec,good))-EROWZ(reg,good))>checktol and abs(sum(rr,(XZ(rr,good)-MROWZ(rr,good))))<=checktol)= 11;
1023   
1024  if (sum((reg,good),rgcount(reg,good)) <>0,
1025     display "Problems with splitting XDDE_o for product and region"
1026     display rgcount;
1027  );
1028   
1029   
1030   
1031   
1032  * AW 16/12 + 18/12
1033  display "div0 12";
1034  rgcount(reg,good)=0;
1035  XDDE_d(good,reg2,reg)$(abs(XZ(reg,good)-MROWZ(reg,good))<=checktol)=0;
1036  XDDE_d(good,reg2,reg)$((sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good))))>checktol) = scal*(XZ(reg,good)- MROWZ(reg,good))*(sum(sec,XDDZ(reg2,sec,good))- EROWZ(reg2,good))
1037                         /sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)) ) ;
1038  rgcount(reg,good)$(abs(XZ(reg,good)-MROWZ(reg,good))>checktol and (sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)) ) <=checktol)) =12;
1039  *rgcount(reg,good)$((sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)) ) = 0)) =12;
1040  *** AW 19/1: to check wrt. problems in gravity model - do "UNDF" entries in XDDE_d vause the problems?
1041  *XDDE_d(good,reg2,reg)$(abs(XZ(reg,good)-MROWZ(reg,good))>checktol and abs(sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)) ) <=checktol)) = (XZ(reg,good)-MROWZ(reg,good))/card(reg);
1042   
1043  if (sum((reg,good),rgcount(reg,good)) <>0,
1044     display "Problems with splitting XDDE_d for product and region"
1045     display rgcount;
1046  );
1047   
1048  *XDDE_d(good,reg2,reg) = scal*(XZ(reg,good)- MROWZ(reg,good))*(sum(sec$mapSecGood(sec,good),XDZ(sec,reg2))- EROWZ(reg2,good))
1049  *                       /sum(rr,(sum(sec$mapSecGood(sec,good),XDZ(sec,rr))- EROWZ(rr,good)) ) ;
1050   
1051  SUM_o(reg,good) = sum(rr, XDDE_o(good,rr,reg)) ;
1052  SUM_d(reg,good) = sum(rr, XDDE_d(good,reg,rr)) ;
1053   
1054  Parameter demandr(reg,good), supplyr(reg,good);
1055  demandr(reg,good) = (XZ(reg,good) -  MROWZ(reg,good))*scal ;
1056  supplyr(reg,good)$((sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))<=checktol)=0;
1057  supplyr(reg,good)$((sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))>checktol)=(sum(sec,XDDZ(reg,sec,good)) - EROWZ(reg,good))*scal ;
1058  Display demandr,supplyr ;
1059   
1060  Parameter ch_difference(good), transpm(good),taxcz(good);
1061  *ch_difference(good)  = sum(reg,SUM_o(reg,good)) - sum(reg,SUM_d(reg,good)) ;
1062  *The old version based on transportmargins included
1063  ch_difference(good)  = sum(reg,SUM_o(reg,good)) + TAXCZ(good) + TMCZ(good) - sum(reg,SUM_d(reg,good)) ;
1064   
