 274  *-------------------------------------------------------
 275  * convert SAM submatrices to user sectors & products & fin
 276  UGFN(good,fin)=sum((Pgood,Pfin)$(mapPGood(Pgood,good) and mapPFin(Pfin,fin)), PGF(Pgood,Pfin));
 277  USFN(sec,fin)=sum((Psec,Pfin)$(mapPSec(Psec,sec) and mapPFin(Pfin,fin)), PSF(Psec,Pfin));
 278  UFFN(ff,fin)=sum((p_ff,Pfin)$(mapPFin(p_ff,ff) and mapPFin(Pfin,fin)), PFF(p_ff,Pfin));
 279  UFGN(fin,good)=sum((Pfin,Pgood)$(mapPFin(Pfin,fin) and mapPGood(Pgood,good)), PFG(Pfin,Pgood));
 280  UFSN(fin,sec)=sum((Pfin,Psec)$(mapPFin(Pfin,fin) and mapPSec(Psec,sec)), PFS(Pfin,Psec));
 281  * USGN and UGSN are needed for composing the national SAM
 282  UGSN(good,sec)= sum((Pgood,Psec)$(mapPGood(Pgood,good) and mapPSec(Psec,sec)),PGS(Pgood,Psec));
 283  USGN(sec,good)= sum((Pgood,Psec)$(mapPSec(Psec,sec) and mapPGood(Pgood,good)),PSG(Psec,Pgood));
 284   
 285  * mapSecGood indicates whether good is supplied by sec
 286  * AW 2/12-14: CREEA data don't have a unique mapping / diagonal supply matrix
 287  * -> can have several mapSecGood = 1 for given sec or for given good
 288  * need distrGoodSupplySAM in addition (?)
 289  ** AW 5/12: rewrote concerned parts, mapSecGood not needed anymore
 290  * mapSecGood(sec,good)$(USGN(sec,good))=1;
 291  *display mapSecGood;
 292  *execute_unload 'UserGSF.gdx' UGFN,UGSN,USGN, USFN, UFFN, UFGN, UFSN, mapSecGood, distrGoodSupplySAM;
 293  execute_unload 'UserGSF.gdx' UGFN,UGSN,USGN, USFN, UFFN, UFGN, UFSN, distrGoodSupplySAM;
