 740  *IOZ(reg,good,sec)$((sum((reg2,ss)$mapSecGood(ss,good),indicIO(ss,sec,reg2)) eq 0) and
 741  IOZ(reg,good,sec)$((sum(reg2,indicIO(reg2,good,sec)) eq 0) and
 742                      UGSN(good,sec))
 743                      = UGSN(good,sec) *XDZ(sec,reg)/sum(reg2,XDZ(sec,reg2)) ;
 744  * =================                                   ========================== *
 745   
 746  * =================           Row parameters                                    ====================== *
 747  *TAXPZ(sec,reg)            =     sum(fin$mapPFin('137',fin),UFSN(fin,sec))*( XDZ(sec,reg)/sum(reg2,XDZ(sec,reg2)) )  ;
 748   
 749  * AW 16/12
 750  display "div0 1";
 751  TAXPZ(sec,reg)$(abs(sum(fin$mapPFin('137',fin),UFSN(fin,sec)))<=checktol)=0;
 752  TAXPZ(sec,reg)$(abs(sum(fin$mapPFin('137',fin),UFSN(fin,sec)))>checktol) = sum(fin$mapPFin('137',fin),UFSN(fin,sec))*( XDZ(sec,reg)/sum(reg2,XDZ(sec,reg2)) )  ;
 753  ccount(sec)$(abs(sum(fin$mapPFin('137',fin),UFSN(fin,sec)))>checktol and abs(sum(reg2,XDZ(sec,reg2))<=checktol))=1 ;
 754  *);
 755  if (sum(sec,ccount(sec)) >0,
 756     display ccount;
 757  );
 758   
 759  LZ(sec,reg)           =  sum(fin$mapPFin('131',fin),UFSN(fin,sec))*indicPROD(reg,sec) ;
 760  LSZ(reg)              =  sum(sec,LZ(sec,reg)) ;
 761   
 762  *used as an balancing parameter
 763  capital(reg,sec)$(abs(XDZ(sec,reg)>checktol)) = XDZ(sec,reg) - TAXPZ(sec,reg) - sum(good,IOZ(reg,good,sec))- LZ(sec,reg);
 764   
 765  * This is the NEG version from Olga
 766  *capital(sec,reg)$XDZ(sec,reg) = XDZ(sec,reg) + (SUBPZ(sec)- TAXPZ(sec))*XDZ(sec,reg)
 767  *                   /sum(regg,XDZ(sec,regg)) - sum(secc,IOZ(secc,sec,reg))
