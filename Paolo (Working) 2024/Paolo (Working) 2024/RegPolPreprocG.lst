 733  *IOZ(reg,good,sec) = UGSN(good,sec)*sum(ss$mapSecGood(ss,good),indicIO(ss,sec,reg));
 734  * AW 3/12
 735  IOZ(reg,good,sec) = UGSN(good,sec)*indicIO(reg,good,sec);
 736  *IOZ(ss,sec,reg) = sum(good$mapSecGood(ss,good),UGSN(good,sec))*indicIO(sec,ss,reg) ;
