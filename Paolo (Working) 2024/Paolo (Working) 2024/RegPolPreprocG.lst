 870  if (sum(good,gcount(good)) <>0,
 871     display "SVZ regionalisation not OK for product"
 872     display gcount;
 873  );
 874   
 875  * =================                                        ====================== *
 876   
 877  * not sure if this is a good regionalization (Ulf) This parameter is not regionlized in the other code from OLGA *
 878  SGZ(reg)     = sum((fin,ff)$(mapPFin('144',fin) and mapPFin('143',ff)),UFFN(fin,ff))* sum(good,CGZ(reg,good))/sum((rr,good),CGZ(rr,good));
 879  *TAXRZ(reg)          =    TAXCZ(sec) +  TAXPZ(sec) + TTYZ(reg) );
 880  *=================                                                       ====================== *
 881   
 882  * =================         Production of Trade and transport margins                ====================== *
 883  TMCZ(good)$(sum(fin$mapPFin('146',fin),UFGN(fin,good)) gt checktol) =  sum(fin$mapPFin('146',fin),UFGN(fin,good)) ;
 884   
