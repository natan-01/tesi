 803   
 804  KSZ(reg)              =  sum(sec,KZ(sec,reg)) ;
 805  YZ(reg)               =  LSZ(reg) + KSZ(reg) ;
 806   
 807  display indicCons, indicIO, UGFN;
 808   
 809   
 810  * ================= Consumer demand       ================================
      === *
 811  CZ(reg,good)     = sum(fin$mapPFin('142',fin),UGFN(good,fin))*indicCONS(re
      g,good) ;
 812  CBUDZ(reg)   =  sum(good,CZ(reg,good)) ;
 813   
 814  * =================          Savings and transfers                       =
      ===================== *
 815  TRYZ            =  sum((fin,ff)$(mapPFin('134',fin) and mapPFin('142',ff))
      ,UFFN(fin,ff)) ;
 816   
 817  TTYZ(reg)       = TRYZ*YZ(reg)/sum(rr,YZ(rr));
 818  *TTYZ(reg)       =  sum((fin,ff)$(mapPFin('134',fin) and mapPFin('142',ff)
      ),UFFN(fin,ff))* sum(good,CZ(reg,good))/sum((rr,gg),CZ(rr,gg));
 819   
 820  SHZ(reg)     =  sum((fin,ff)$(mapPFin('144',fin) and mapPFin('142',ff)),UF
      FN(fin,ff))*(YZ(reg)- TRYZ*YZ(reg)/sum(rr,YZ(rr)))
 821                     /sum(reg2,(YZ(reg2)- TRYZ*YZ(reg2)/sum(rr,YZ(rr))) ) ;
 822   
 823  TRANSFZ(reg)         =     sum((fin,ff)$(mapPFin('142',fin) and mapPFin('1
      43',ff)),UFFN(fin,ff))* ( CBUDZ(reg) - YZ(reg)
 824                     +  TRYZ*YZ(reg)/sum((reg2),YZ(reg2)) + SHZ(reg))
 825                     /sum((rr),( CBUDZ(rr) - YZ(rr)
 826                     +  TRYZ*YZ(rr)/sum((reg2),YZ(reg2)) + SHZ(rr)) ) ;
 827   
 828  *TRFZ(th,reg)     =  SAM("59","60")*( CBUDZ(th,reg) - YZ(th,reg)
 829  *                   +  TRYZ*YZ(th,reg)/sum((thh,regg),YZ(thh,regg)) + SHZ(
      th,reg))
 830  *                   /sum((thhh,reggg),( CBUDZ(thhh,reggg) - YZ(thhh,reggg)
 831  *                   +  TRYZ*YZ(thhh,reggg)/sum((thh,regg),YZ(thh,regg)) + 
      SHZ(thhh,reggg)) ) ;
 832   
 833  display TRANSFZ;
 834   
 835  TAXCZ(good)       =     sum(fin$mapPFin('138',fin),UFGN(fin,good)) ;
 836   
 837  *Column parameters
 838  * ================= Cheking if EROWZ is smaler than XDDZ and reducing EROW
      Z and MROWZ with this amount       ====================== *
 839  * We are adding a small number: 0.1, because we don't want to have the num
      ber 0
 840  parameter Adj_EROWZ_MROWZ(good),EROWZ_sjekk(reg,good);
 841  Adj_EROWZ_MROWZ(good)$(sum(sec,USGN(sec,good)) - sum(fin$mapPFin('149',fin
      ),UGFN(good,fin)) <  0) = sum(sec,USGN(sec,good)) - sum(fin$mapPFin('149',
      fin),UGFN(good,fin) + checktol);
 842  *Adj_EROWZ_MROWZ(good)=0;
 843  * =================                                                       
                                          ====================== *
 844  * ================= Export to the rest of the world       ================
      ====== *
 845  EROWZ(reg,good)  = (sum(fin$mapPFin('149',fin),UGFN(good,fin)) + Adj_EROWZ
      _MROWZ(good))*indicEXP(reg,good);
 846  EROWZ_sjekk(reg,good) =  (sum(fin$mapPFin('149',fin),UGFN(good,fin)))*indi
      cEXP(reg,good);
 847  display EROWZ;
 848   
 849   
 850  * ================= Goverment demand       ====================== *
 851  CGZ(reg,good)    = sum(fin$mapPFin('143',fin),UGFN(good,fin))*indicCONSgov
      (reg,good);
 852  CBUDGZ(reg)          = sum(good,CGZ(reg,good)) ;
 853   
 854  * =================          Investment                       ============
      ========== *
 855  IZ(reg,good)     = sum(fin$mapPFin('144',fin),UGFN(good,fin))*indicINV(reg
      ,good);
 856  ITZ(reg)             = sum(good,IZ(reg,good)) ;
 857  *IZ(sec,reg)$((sum(regg,indicINV(regg,sec)) eq 0) and sum(map(cm,sec),SAM(
      cm,"61")))
 858  *                = sum(map(cm,sec),SAM(cm,"61"))
 859  *                *sum(secc,IZ(secc,reg))/sum(regg,sum(secc,IZ(secc,regg)))
       ;
 860  display "div0 6";
 861   
 862   
 863  * =================          Changes inventories                       ===
      =================== *
 864  gcount(good)=0;
 865  SVZ(reg,good)$(abs(sum(fin$mapPFin('145',fin),UGFN(good,fin)))<= checktol)
      =0;
 866  SVZ(reg,good)$(abs(sum(fin$mapPFin('145',fin),UGFN(good,fin)))>checktol) =
       (sum(fin$mapPFin('145',fin),UGFN(good,fin)))*( CZ(reg,good) + CGZ(reg,goo
      d)+ sum(ss,IOZ(reg,good,ss)) )
 867                    /sum(reg2,(CZ(reg2,good) + CGZ(reg2,good)+ sum(ss,IOZ(re
      g2,good,ss)) )) ;
 868  gcount(good)$(abs(sum(fin$mapPFin('145',fin),UGFN(good,fin)))>checktol and
       abs(sum(reg2,(CZ(reg2,good) + CGZ(reg2,good)+ sum(ss,IOZ(reg2,good,ss))))
      <=checktol)) = 6;
 869   
 870  if (sum(good,gcount(good)) <>0,
 871     display "SVZ regionalisation not OK for product"
 872     display gcount;
 873  );
 874   
 875  * =================                                        ===============
      ======= *
 876   
 877  * not sure if this is a good regionalization (Ulf) This parameter is not r
      egionlized in the other code from OLGA *
 878  SGZ(reg)     = sum((fin,ff)$(mapPFin('144',fin) and mapPFin('143',ff)),UFF
      N(fin,ff))* sum(good,CGZ(reg,good))/sum((rr,good),CGZ(rr,good));
 879  *TAXRZ(reg)          =    TAXCZ(sec) +  TAXPZ(sec) + TTYZ(reg) );
 880  *=================                                                       =
      ===================== *
 881   
 882  * =================         Production of Trade and transport margins     
                 ====================== *
 883  TMCZ(good)$(sum(fin$mapPFin('146',fin),UFGN(fin,good)) gt checktol) =  sum
      (fin$mapPFin('146',fin),UFGN(fin,good)) ;
 884   
 885  display "Trade margins";
 886  display CZ, CGZ, IOZ;
 887  TMXZ(reg,good)$(sum(rr,CZ(rr,good)+ CGZ(rr,good) + sum(sec,IOZ(rr,good,sec
      )))) =sum(fin$mapPFin('146',fin),UGFN(good,fin))
 888                    *(CZ(reg,good) + CGZ(reg,good)+ sum(sec,IOZ(reg,good,sec
      )))/sum(rr,CZ(rr,good)+ CGZ(rr,good) + sum(sec,IOZ(rr,good,sec)) ) ;
 889  TMTZ(reg)       = sum(good,TMXZ(reg,good));
 890  display TMTZ, TMXZ;
 891  * =================       Fiks for balancing trade and transport margins  
                                     ====================== *
 892  * Adjusting this code to make the trade and transport margins balanced
 893  * AW 18/12 - checking division by zero
 894  display "div0 8";
 895  gcount(good)=0;
 896  TMCZ_R(reg,good)$(abs(TMCZ(good))<=checktol)=0;
 897  TMCZ_R(reg,good)$(abs(TMCZ(good))>checktol  and (sum(reg2, CZ(reg2,good)+ 
      CGZ(reg2,good)  ) + sum((reg2,ss), IOZ(reg2,good,ss)) ))
 898           = TMCZ(good)*( CZ(reg,good)+ CGZ(reg,good) +  sum(sec, IOZ(reg,go
      od,sec)) )/
 899          ( sum(reg2, CZ(reg2,good)+ CGZ(reg2,good)  ) + sum((reg2,ss), IOZ(
      reg2,good,ss)) );
 900  gcount(good)$(abs(TMCZ(good))>checktol and abs(sum(reg2,(CZ(reg2,good) + C
      GZ(reg2,good)+ sum(ss,IOZ(reg2,good,ss)) )) <= checktol)) = 8;
 901   
 902  if (sum(good,gcount(good)) <>0,
 903     display "regionalisation of trade and transport margins not OK for prod
      uct(s)"
 904     display gcount;
 905  );
 906   
 907  display TMCZ;
 908   
 909   
 910  * ====================                                           =========
      =============== *
 911  * =================          Redefining parameters                     ===
      =================== *
 912  *Redefinition of consumption,investments and intermediate consumption
 913  *(as net of taxes and subsidies)
 914  *Note that prices of commodities include transport and trade margins
 915  Parameter
 916  CZ_old(reg,good)
 917  IZ_old(reg,good)
 918  CGZ_old(reg,good)
 919  IOZ_old(reg,good,sec)
 920  TAX_total(good)
 921  DEM_total(good)
 922  ;
 923   
 924  CZ_old(reg,good) = CZ(reg,good)  ;
 925  IZ_old(reg,good) = IZ(reg,good)  ;
 926  CGZ_old(reg,good)  = CGZ(reg,good) ;
 927  IOZ_old(reg,good,sec)  = IOZ(reg,good,sec) ;
 928  TAX_total(good)    = TAXCZ(good)+ TMCZ(good) ;
 929  *The old version with transportmargins excluded
 930  *TAX_total(good)    = TAXCZ(good) ;
 931   
 932  *creating the regional version of product taxes
 933  * AW 18/12
 934  display "div0 9";
 935  gcount(good)=0;
 936  TAXCZ_R(reg,good)$(abs(TAXCZ(good))<= checktol) = 0;
 937  TAXCZ_R(reg,good)$(abs(TAXCZ(good))>checktol and sum(reg2, CZ(reg2,good)+ 
      CGZ(reg2,good) + IZ(reg2,good) ) + sum((reg2,ss), IOZ(reg2,good,ss)))
 938           = TAXCZ(good)*( CZ(reg,good)+ CGZ(reg,good) + IZ(reg,good) + sum(
      sec, IOZ(reg,good,sec)) )/
 939          ( sum(reg2, CZ(reg2,good)+ CGZ(reg2,good) + IZ(reg2,good) ) + sum(
      (reg2,ss), IOZ(reg2,good,ss)) );
 940  gcount(good)$(abs(TAXCZ(good))>checktol and abs(sum(reg2, CZ(reg2,good)+ C
      GZ(reg2,good) + IZ(reg2,good) ) + sum((reg2,ss), IOZ(reg2,good,ss)) <=chec
      ktol)) =9;
 941   
 942  if (sum(good,gcount(good)) <>0,
 943     display "regionalisation of product taxes not OK for product"
 944     display gcount;
 945  );
 946   
 947  DEM_total(good)    = sum(reg, CZ(reg,good)+ CGZ(reg,good) + IZ(reg,good)) 
      + sum((reg,sec), IOZ(reg,good,sec))  ;
 948   
 949  *CZ(reg,good)$CZ(reg,good)   = CZ(reg,good)  - TAX_total(good)*CZ_old(reg,
      good)/DEM_total(good) ;
 950  *IZ(reg,good)$IZ(reg,good)   = IZ(reg,good)  - TAX_total(good)*IZ_old(reg,
      good)/DEM_total(good) ;
 951  *CGZ(reg,good)$CGZ(reg,good) = CGZ(reg,good) - TAX_total(good)*CGZ_old(reg
      ,good)/DEM_total(good) ;
 952  *IOZ(reg,good,sec)$IOZ(reg,good,sec) = IOZ(reg,good,sec) - TAX_total(good)
      *IOZ_old(reg,good,sec)/DEM_total(good) ;
 953  Display CZ, IZ, CGZ ;
 954   
 955  *loop ((sec,reg),
 956  *
 957  *  if ((CZ(sec,reg) lt 0)  ,
 958  *          abort "check CZ(sec,reg) "
 959  *     );
 960  *  ) ;
 961  *   if ((IZ(sec,reg) lt 0)  ,
 962  *          abort "check IZ(sec,reg) "
 963  *   );
 964  *   if ((CGZ(sec,reg) lt 0)  ,
 965  *          abort "CGZ(sec,reg) "
 966  *   );
 967  *);
 968   
 969  Parameter
 970  TMXZ_old(reg,good)
 971  ;
 972  TMXZ_old(reg,good)=  TMXZ(reg,good) ;
 973   
 974  * Adjusting trade and transportmargins such that rows and columns is balan
      ced
 975  *TMXZ(reg,good)=     TMXZ(reg,good) + TMXZ_old(reg,good)/sum(gg,TMXZ_old(r
      eg,gg))  *    sum(gg, TMCZ_R(reg,gg) -  TMXZ_old(reg,gg)) ;
 976  ** AW 31/10 Muligens ikke nødvendig? (får skeivfordeling tm/tf både med og
       uten)
 977   
 978  display TMCZ_R, TMXZ,TMXZ_old;
 979  * =================                          ====================== *
 980   
 981   
 982  * =================          Initial domestic sales                =======
      =============== *
 983  XZ(reg,good)     = CZ(reg,good)+ CGZ(reg,good) + IZ(reg,good)+ SVZ(reg,goo
      d)
 984                    + TMXZ(reg,good) + sum(sec,IOZ(reg,good,sec)) ;
 985   
 986   
 987  * =================          Initial import                ===============
      ======= *
 988  **MROWZ(sec,reg)  = sum((good,fin)$(mapSecGood(sec,good) and mapPFin('149'
      ,fin)),UFGN(fin,good))*XZ(sec,reg)/sum(rr,XZ(sec,rr))  ;
 989  display "div0 10";
 990  gcount(good)=0;
 991  MROWZ(reg,good)$(abs(sum(fin$mapPFin('149',fin),UFGN(fin,good))+ Adj_EROWZ
      _MROWZ(good))<=checktol)=0;
 992  MROWZ(reg,good)$(abs(sum(fin$mapPFin('149',fin),UFGN(fin,good)+ Adj_EROWZ_
      MROWZ(good)))>checktol) = sum(fin$mapPFin('149',fin),UFGN(fin,good)+ Adj_E
      ROWZ_MROWZ(good))*XZ(reg,good)/sum(rr,XZ(rr,good));
 993  gcount(good)$(abs(sum(fin$mapPFin('149',fin),UFGN(fin,good)+ Adj_EROWZ_MRO
      WZ(good)))>checktol and abs(sum(rr,XZ(rr,good))<=checktol))=10;
 994   
 995  if(sum(good,gcount(good))<>0,
 996     display "Regionalisation of imports not OK for product"
 997     display gcount;
 998  );
 999   
1000  display MROWZ;
1001   
1002  *This is the gravity formulation
1003  *---estimation of the interregional trade flows
1004  Parameters
1005  XDDE_o(good,reg,reg) initial split according to origin indic
1006  XDDE_d(good,reg,reg) initial split according to destination split
1007  SUM_o(reg,good)
1008  SUM_d(reg,good)
1009  cons_check(good,reg,reg) consistency check
1010  ;
1011   
1012  *This formulation is based on distance *
1013  *XDDE_o(sec,reg,regg) = (XDZ(sec,reg)- EROWZ(sec,reg) )*indic_trade2(reg,r
      egg,sec) ;
1014  *XDDE_d(sec,regg,reg) = (XZ(sec,reg) -  MROWZ(sec,reg))*indic_trade3(regg,
      reg,sec) ;
1015   
1016  * AW 16/12 + 18/12
1017  display "div0 11";
1018  rgcount(reg,good)=0;
1019  XDDE_o(good,reg,reg2)$((sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))<=che
      cktol)=0;
1020  XDDE_o(good,reg,reg2)$((sum(rr,(XZ(rr,good)-MROWZ(rr,good))))>checktol) = 
      scal*(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))*(XZ(reg2,good) - MROWZ
      (reg2,good))
1021                         /sum(rr,(XZ(rr,good)-MROWZ(rr,good)));
1022  rgcount(reg,good)$((sum(sec,XDDZ(reg,sec,good))-EROWZ(reg,good))>checktol 
      and abs(sum(rr,(XZ(rr,good)-MROWZ(rr,good))))<=checktol)= 11;
1023   
1024  if (sum((reg,good),rgcount(reg,good)) <>0,
1025     display "Problems with splitting XDDE_o for product and region"
1026     display rgcount;
1027  );
1028   
1029   
1030   
1031   
1032  * AW 16/12 + 18/12
1033  display "div0 12";
1034  rgcount(reg,good)=0;
1035  XDDE_d(good,reg2,reg)$(abs(XZ(reg,good)-MROWZ(reg,good))<=checktol)=0;
1036  XDDE_d(good,reg2,reg)$((sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)
      )))>checktol) = scal*(XZ(reg,good)- MROWZ(reg,good))*(sum(sec,XDDZ(reg2,se
      c,good))- EROWZ(reg2,good))
1037                         /sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)
      ) ) ;
1038  rgcount(reg,good)$(abs(XZ(reg,good)-MROWZ(reg,good))>checktol and (sum(rr,
      (sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)) ) <=checktol)) =12;
1039  *rgcount(reg,good)$((sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)) )
       = 0)) =12;
1040  *** AW 19/1: to check wrt. problems in gravity model - do "UNDF" entries i
      n XDDE_d vause the problems?
1041  *XDDE_d(good,reg2,reg)$(abs(XZ(reg,good)-MROWZ(reg,good))>checktol and abs
      (sum(rr,(sum(sec,XDDZ(rr,sec,good))- EROWZ(rr,good)) ) <=checktol)) = (XZ(
      reg,good)-MROWZ(reg,good))/card(reg);
1042   
1043  if (sum((reg,good),rgcount(reg,good)) <>0,
1044     display "Problems with splitting XDDE_d for product and region"
1045     display rgcount;
1046  );
1047   
1048  *XDDE_d(good,reg2,reg) = scal*(XZ(reg,good)- MROWZ(reg,good))*(sum(sec$map
      SecGood(sec,good),XDZ(sec,reg2))- EROWZ(reg2,good))
1049  *                       /sum(rr,(sum(sec$mapSecGood(sec,good),XDZ(sec,rr))
      - EROWZ(rr,good)) ) ;
1050   
1051  SUM_o(reg,good) = sum(rr, XDDE_o(good,rr,reg)) ;
1052  SUM_d(reg,good) = sum(rr, XDDE_d(good,reg,rr)) ;
1053   
1054  Parameter demandr(reg,good), supplyr(reg,good);
1055  demandr(reg,good) = (XZ(reg,good) -  MROWZ(reg,good))*scal ;
1056  supplyr(reg,good)$((sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))<=checkto
      l)=0;
1057  supplyr(reg,good)$((sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))>checktol
      )=(sum(sec,XDDZ(reg,sec,good)) - EROWZ(reg,good))*scal ;
1058  Display demandr,supplyr ;
1059   
1060  Parameter ch_difference(good), transpm(good),taxcz(good);
1061  *ch_difference(good)  = sum(reg,SUM_o(reg,good)) - sum(reg,SUM_d(reg,good)
      ) ;
1062  *The old version based on transportmargins included
1063  ch_difference(good)  = sum(reg,SUM_o(reg,good)) + TAXCZ(good) + TMCZ(good)
       - sum(reg,SUM_d(reg,good)) ;
1064   
1065   
1066  * =================          Useful datachecks before before gravity model
              ====================== *
1067  parameter
1068  matrise1(good, *);
1069  matrise1(good, "O") =  sum(reg,SUM_o(reg,good));
1070  matrise1(good, "TAXCZ") =  TAXCZ(good);
1071  matrise1(good, "TMCZ") =  TMCZ(good);
1072  matrise1(good, "D") =  - sum(reg,SUM_d(reg,good));
1073  matrise1(good, "ch_difference") =  sum(reg,SUM_o(reg,good)) + TAXCZ(good) 
      + TMCZ(good) - sum(reg,SUM_d(reg,good));
1074  matrise1(good, "MROWZ") =  sum(reg,MROWZ(reg,good));
1075  matrise1(good, "EROWZ") =  sum(reg,EROWZ(reg,good));
1076  matrise1(good, "XZ - MROWZ") =  sum(reg,XZ(reg,good))-sum(reg,MROWZ(reg,go
      od));
1077  matrise1(good, "XDDZ - EROWZ") =  sum((sec,reg),XDDZ(reg,sec,good))-sum(re
      g,EROWZ(reg,good));
1078  * =================                                                       
              ====================== *
1079   
1080   
1081  Display ch_difference, matrise1 ;
1082   
1083  display "div0 13";
1084  gcount(good)=0;
1085  transpm(good)$(abs(TMCZ(good))<=checktol)=0;
1086  transpm(good)$(abs(TMCZ(good))>checktol) = TMCZ(good)*scal/sum(reg,SUM_o(r
      eg,good)) ;
1087  gcount(good)$(abs(TMCZ(good))>checktol and abs(sum(reg,SUM_o(reg,good))) <
      = checktol) =13;
1088   
1089  if (sum(good,gcount(good)) <>0,
1090     display gcount;
1091  );
1092   
1093  *display SUM_o(reg,good);
1094   
1095   
1096   
1097   
1098  display "div0 14";
1099  gcount(good)=0;
1100  taxcz(good)$(abs(TAXCZ(good))<=checktol)=0;
1101  taxcz(good)$(abs(TAXCZ(good))>checktol) = TAXCZ(good)*scal/sum(reg,SUM_o(r
      eg,good)) ;
1102  gcount(good)$(abs(TAXCZ(good))>checktol and abs(sum(reg,SUM_o(reg,good))) 
      <= checktol) =14;
1103   
1104  if (sum(good,gcount(good)) <>0,
1105     display gcount;
1106  );
1107   
1108  * AW 18/12
1109  *loop(good,
1110  *   if( ch_difference(good) gt 1e-7,
1111  *     abort 'problem with ch_difference(good)'
1112  *     display 'ch_difference'
1113  *   ) ;
1114  *);
1115  gcount(good)=0;
1116  gcount(good)$(abs(ch_difference(good)) > checktol)=1;
1117  if (abs(sum(good, gcount(good))) > checktol,
1118     display "problem with ch-difference for good"
1119     display gcount
1120  );
1121   
1122   
1123  cons_check(good,reg,rr)$((abs(XDDE_o(good,reg,rr) + XDDE_d(good,reg,rr)) >
      checktol)
1124   and ( abs(XDDE_o(good,reg,rr)*XDDE_d(good,reg,rr)) <=checktol)) = 1 ;
1125   
1126  Display cons_check ;
1127   
1128  * AW 18/12
1129  *loop ((good,reg,rr),
1130  *   if ((cons_check(good,reg,rr) eq 1),
1131  *        abort "check cons_check(good,reg,rr)"
1132  *   );
1133  *);
1134   
1135  Display XDDE_o ;
1136   
1137  * AW 18/12
1138  *loop ((good,reg,rr),
1139  *   if ((XDDE_o(good,reg,rr) lt 0),
1140  *        abort "check XDDE_o(good,reg,rr)"
1141  *   );
1142  *);
1143  grrcount(good,reg,rr)=0;
1144  grrcount(good,reg,rr)$(XDDE_o(good,reg,rr) lt checktol) = 1;
1145  if (sum((good,reg,rr),grrcount(good,reg,rr)),
1146    display "check XDDE_o for good, reg, rr";
1147    display grrcount;
1148  );
1149   
1150  Display XDDE_d ;
1151   
1152  * AW 18/12
1153  *loop ((good,reg,rr),
1154  *   if ((XDDE_d(good,reg,rr) lt 0),
1155  *        abort "check XDDE_d(good,reg,rr)"
1156  *   );
1157  *);
1158  grrcount(good,reg,rr)=0;
1159  grrcount(good,reg,rr)$(XDDE_d(good,reg,rr) lt checktol) = 1;
1160  if (sum((good,reg,rr),grrcount(good,reg,rr)),
1161    display "check XDDE_d for good, reg, rr";
1162    display grrcount;
1163  );
1164   
1165  display "===== Starting gravity model =====";
1166   
1167  Positive variables
1168  XDDE_oV(good,reg,reg)
1169  XDDE_dV(good,reg,reg)
1170  SUM_oV(reg,good)
1171  SUM_dV(reg,good)
1172  ;
1173  Variables
1174  entropy
1175  ;
1176   
1177  Equations
1178  EQ1(reg,good)
1179  EQ2(reg,good)
1180  EQ3(good,reg,reg)
1181  EQ4(reg,good)
1182  EQ5(reg,good)
1183  EQentropy
1184  EQentropy2
1185  ;
1186   
1187  * AW 2/12: bruk XDDZ direkte istf. XDZ og mapSecGood
1188  EQ1(reg,good)$(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))..
1189  *EQ1(reg,good)$(sum(sec$mapSecGood(sec,good),XDZ(sec,reg))- EROWZ(reg,good
      ))..
1190  *               scal*(sum(sec$mapSecGood(sec,good),XDZ(sec,reg))- EROWZ(re
      g,good)) =E=
1191                 scal*(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good)) =E=
1192                 sum(rr, XDDE_oV(good,reg,rr)) ;
1193   
1194  EQ2(reg,good)$(XZ(reg,good)-MROWZ(reg,good) )..
1195                 scal*(XZ(reg,good)-MROWZ(reg,good) ) =E=
1196                 sum(rr, XDDE_dV(good,rr,reg) ) ;
1197   
1198  EQ3(good,reg,rr)$(XDDE_o(good,reg,rr)*XDDE_d(good,reg,rr))..
1199                 XDDE_dV(good,reg,rr)  =E= XDDE_oV(good,reg,rr)*(1+transpm(g
      ood)+taxcz(good)) ;
1200  * The old version with trade and transportmargins included
1201  *XDDE_dV(good,reg,rr)  =E= XDDE_oV(good,reg,rr)*(1+transpm(good)) ;
1202   
1203   
1204  EQ4(reg,good)$SUM_o(reg,good).. SUM_oV(reg,good) =E= sum(rr, XDDE_oV(good,
      rr,reg)) ;
1205   
1206  EQ5(reg,good)$SUM_d(reg,good).. SUM_dV(reg,good) =E= sum(rr, XDDE_dV(good,
      reg,rr)) ;
1207   
1208  *EQentropy.. entropy =E= sum((sec,reg)$SUM_o(sec,reg),SUM_oV(sec,reg)
1209  *            *log(SUM_oV(sec,reg)/SUM_o(sec,reg)))
1210  *            + sum((sec,reg)$SUM_d(sec,reg),SUM_dV(sec,reg)
1211  *            *log(SUM_dV(sec,reg)/SUM_d(sec,reg)));
1212   
1213  EQentropy.. entropy =E= sum((good,reg,rr)$(abs(XDDE_o(good,reg,rr)) > chec
      ktol),XDDE_oV(good,reg,rr)
1214              *log(XDDE_oV(good,reg,rr)/XDDE_o(good,reg,rr)))
1215              + sum((good,reg,rr)$(abs(XDDE_d(good,reg,rr))>checktol),XDDE_d
      V(good,reg,rr)
1216             *log(XDDE_dV(good,reg,rr)/XDDE_d(good,reg,rr)));
1217   
1218  EQentropy2.. entropy =E= 1;
1219   
1220  Model entropy_min /EQ1,EQ2,EQ3,EQ4,EQ5,EQentropy2/ ;
1221   
1222  *** give some start values
1223  XDDE_oV.L(good,reg,rr)  =  XDDE_o(good,reg,rr) ;
1224  XDDE_dV.L(good,rr,reg)  =  XDDE_d(good,rr,reg) ;
1225  SUM_oV.L(reg,good)      =  SUM_o(reg,good)       ;
1226  SUM_dV.L(reg,good)      =  SUM_d(reg,good)       ;
1227   
1228  XDDE_oV.LO(good,reg,rr) =  0.000001*XDDE_o(good,reg,rr) ;
1229  XDDE_dV.LO(good,rr,reg) =  0.000001*XDDE_d(good,rr,reg) ;
1230  SUM_oV.LO(reg,good)       =  0.000001*SUM_o(reg,good)       ;
1231  SUM_dV.LO(reg,good)       =  0.000001*SUM_d(reg,good)       ;
1232   
1233  XDDE_oV.FX(good,reg,rr)$(abs(XDDE_o(good,reg,rr))< checktol) =  0 ;
1234  XDDE_dV.FX(good,rr,reg)$(abs(XDDE_d(good,rr,reg))<checktol) =  0 ;
1235  SUM_oV.FX(reg,good)$(abs(SUM_o(reg,good))<checktol)         =  0       ;
1236  SUM_dV.FX(reg,good)$(abs(SUM_d(reg,good)) < checktol)           =  0      
      ;
1237   
1238  option nlp=PATHNLP;
1239  Solve entropy_min using nlp minimizing entropy;
1240   
1241  Display XDDE_oV.L ;
1242  *** AW 23/1-15
1243  *loop ((good,reg,rr),
1244  *   if ((XDDE_oV.L(good,reg,rr) lt checktol),
1245  *        abort "check XDDE_o(good,reg,rr)"
1246  *   );
1247  *);
1248   
1249   
1250  Display XDDE_dV.L ;
1251  *** AW 23/1-15
1252  *loop ((good,reg,rr),
1253  *   if ((XDDE_dV.L(good,reg,rr) lt checktol),
1254  *        abort "check XDDE_d(good,reg,rr)"
1255  *   );
1256  *);
1257   
1258  Parameter diffXD(reg,good),diffX(reg,good),indicator_sec(good),diffXD2(reg
      ,good) ;
1259   
1260  diffXD(reg,good)$(abs(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good))>checkt
      ol)
1261                 = scal*(sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good) ) -
1262                 sum(rr, XDDE_oV.L(good,reg,rr)) ;
1263   
1264  diffX(reg,good)$(abs(XZ(reg,good) - MROWZ(reg,good))>checktol)
1265                 = scal*(XZ(reg,good)-MROWZ(reg,good) ) -
1266                 sum(rr, XDDE_dV.L(good,rr,reg) ) ;
1267   
1268  indicator_sec(good)= max(sum(reg,diffXD(reg,good)),sum(reg,diffX(reg,good)
      )) ;
1269   
1270  Display XDDE_oV.L, diffXD, diffX,indicator_sec, entropy.L ;
1271   
1272   
1273  * Transport margins
1274  TAXCZR(reg,rr,good) =  XDDE_oV.L(good,reg,rr)*taxcz(good)/scal;
1275  TMCRZ(reg,rr,good) =  XDDE_oV.L(good,reg,rr)*transpm(good)/scal;
1276   
1277  display  TAXCZR, TMCRZ;
1278   
1279  * Interreginonal trade
1280  TRADEZ(good,reg,rr) = XDDE_oV.L(good,reg,rr)/scal ;
1281  TRADEZ_f(good,rr) = sum(reg,XDDE_oV.L(good,reg,rr)) ;
1282  TRADEZ_t(good,reg) = sum(rr,XDDE_oV.L(good,reg,rr)) ;
1283   
1284  * AW 2/12: bruk XDDZ direkte istf. XDZ og mapSecGood
1285  *diffXD(reg,good) = sum(sec$mapSecGood(sec,good),XDZ(sec,reg))- EROWZ(reg,
      good) - sum(rr, TRADEZ(good,reg,rr)) ;
1286  diffXD(reg,good) = sum(sec,XDDZ(reg,sec,good))- EROWZ(reg,good) - sum(rr, 
      TRADEZ(good,reg,rr)) ;
1287   
1288  diffX(reg,good) = XZ(reg,good) - MROWZ(reg,good)  -
1289  *               sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good)+ TAXCZR(r
      r,reg,good))  ;
1290                 sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good))  ;
1291   
1292  Parameter TMCRZ_f(reg,good),  TAXCZR_f(reg,good);
1293   
1294  TMCRZ_f(reg,good) = sum(rr, TMCRZ(rr,reg,good))  ;
1295  TAXCZR_f(reg,good)  = sum(rr,TAXCZR(rr,reg,good))  ;
1296   
1297  *The old version with trade and transportmarginsincluded included
1298  *sum(rr, TRADEZ(good,rr,reg) + TMCRZ(rr,reg,good))  ;
1299   
1300  display XZ,diffXD,diffX,TMCRZ_f,TAXCZR_f,TRADEZ_f;
1301   
1302  ** AW 30/9-14: this is just calculated, never written to mSAM or used furt
      her...
1303  XXDZ(reg,good)  =  sum(sec,XDDZ(reg,sec,good)) - sum(rr,TRADEZ(good,reg,rr
      )) - EROWZ(reg,good) ;
1304   
1305  *Execute_unload "sjekk"   TMCZ_R,  TMCRZ;
1306  display CZ_old, CZ;
1307   
1308  * 4) build one common regionalised SAM
INCLUDE    C:\Users\pisciell\Documents\AllFiles\CreateSAM\Paolo 2024\Paolo 2024\
           includes\write_msam.gms
1310  display  " (4) combine the single parameters to regionalised SAMs in mSAM"
1311  display  "     also, write out interregional trade data and transport marg
      ins"
1312   
1313   
1314  Parameters
1315      mSAM(reg,*,*)
1316      mTradeData(good,*,*)
1317      mTradeMargins(good,reg,reg)
1318  ;
1319   
1320  mSAM(reg,good,sec)= IOZ_old(reg,good,sec);
1321   
1322   
1323  * =================                                   ====================
      ====== *
1324  *When writing XDDZ to MSAM we have to take out some values for R6 (Sokkele
      n) because of small numbers and this is creating errors in the MPSGE-kode
1325  scalars
1326   checktol_2 /1e-08/
1327   checktol_3 /1e-20/
1328  ;
1329   
1330  *mSAM(reg,sec,good)=XDDZ(reg,sec,good)
1331  mSAM(reg,sec,good)=XDDZ(reg,sec,good);
1332  *$(not XDDZ(reg,sec,good)<checktol_3);
1333  * =================                                   ====================
      ====== *
1334   
1335  mSAM(reg,fin,sec)$mapPFin('131',fin) = LZ(sec,reg);
1336  mSAM(reg,fin,sec)$mapPFin('135',fin) = KZ(sec,reg);
1337   
1338   
1339   
1340  mSAM(reg,good,fin)$mapPFin('142',fin) = CZ_old(reg,good);
1341  mSAM(reg,good,fin)$mapPFin('143',fin) = CGZ_old(reg,good);
1342  mSAM(reg,good,fin)$mapPFin('144',fin) = IZ_old(reg,good);
1343  mSAM(reg,good,fin)$mapPFin('145',fin) = SVZ(reg,good);
1344   
1345   
1346   
1347  mTradeData(good,reg,reg2) = TRADEZ(good,reg,reg2);
1348  *$(not TRADEZ(good,reg,reg2)<checktol_3);
1349   
1350  mTradeData(good,reg,fin)$mapPFin('149',fin)= EROWZ(reg,good) ;
1351  *$(not EROWZ(reg,good)<checktol_3);
1352  mTradeData(good,fin,reg)$mapPFin('149',fin) = MROWZ(reg,good)  ;
1353  *$(not MROWZ(reg,good)<checktol_3);
1354   
1355   
1356   
1357  * Outgoing trade is the sum of TRADEZ (trade to other regions) and EROWZ (
      export to RestOfWorld)
1358  mSAM(reg,good,'trade')= EROWZ(reg,good) + sum(reg2$(ord(reg2)<>ord(reg)),T
      RADEZ(good,reg,reg2)) ;
1359  *$(not TRADEZ(good,reg,reg2)<checktol_3)) ;
1360  * Import is the sum of TRADEZ (trade from other regions) and MROWZ (import
       from RestOfWorld)
1361  mSAM(reg,'trade',good)= MROWZ(reg,good) + sum(reg2$(ord(reg2)<>ord(reg)),T
      RADEZ(good,reg2,reg) );
1362  *$(not TRADEZ(good,reg,reg2)<checktol_3)) ;
1363   
1364  mSAM(reg,good,fin)$mapPFin('146',fin) =TMXZ(reg,good);
1365  display TMXZ;
1366  ** 27/10: Usikker om det skal summeres over fra- eller til-dimensjon
1367  mSAM(reg,fin,good)$mapPFin('146',fin)= sum(reg2,TMCRZ(reg2,reg,good));
1368  mTradeMargins(good,reg,reg2)=TMCRZ(reg,reg2,good) ;
1369  *$(not TMCRZ(reg,reg2,good)<checktol_3);;
1370   
1371   
1372   
1373  mSAM(reg,fin,ff)$(mapPFin('143',fin) and mapPFin('134',ff))=TTYZ(reg);
1374  mSAM(reg,fin,ff)$(mapPFin('142',fin) and mapPFin('143',ff))=TRANSFZ(reg);
1375  mSAM(reg,fin,good)$mapPFin('138',fin)= sum(reg2,TAXCZR(reg2,reg,good));
1376  mSAM(reg,fin,sec)$mapPFin('137',fin) = TAXPZ(sec,reg);
1377  mSAM(reg,fin,sec)$mapPFin('144',fin) = INVZ(sec,reg);
1378  mSAM(reg,fin,ff)$(mapPFin('144',fin) and mapPFin('142',ff)) = SHZ(reg);
1379  mSAM(reg,fin,ff)$(mapPFin('144',fin) and mapPFin('143',ff)) = SGZ(reg);
1380   
1381   
1382   
1383  * Adding zeros where we don't have any values
1384  mSAM(reg,good,sec)$(not mSAM(reg,good,sec))=0;
1385  mSAM(reg,sec,good)$(not mSAM(reg,sec,good))=0;
1386   
1387  **
1388  mSAM(reg,fin,sec)$(not mSAM(reg,fin,sec))=0;
1389  mSAM(reg,fin,ff)$(not mSAM(reg,fin,ff))=0;
1390  mSAM(reg,fin,good)$(not mSAM(reg,fin,good))=0;
1391  mSAM(reg,good,'trade')$(not mSAM(reg,good,'trade'))=0;
1392  mSAM(reg,'trade',good)$(not mSAM(reg,'trade',good))=0;
1393   
1394  * Adding zeros where we don't have any values
1395  mTradeData(good,reg,reg2)$(not mTradeData(good,reg,reg2))=0;
1396  mTradeData(good,reg,fin)$(not mTradeData(good,reg,fin) and mapPFin('149',f
      in))=0;
1397  mTradeData(good,fin,reg)$(not mTradeData(good,fin,reg)and mapPFin('149',fi
      n))=0;
1398   
1399  *Adding zeros where we don't have any values
1400  mTradeMargins(good,reg,reg2)$(not mTradeMargins(good,reg,reg2))=0;
1401   
1402   
1403   
1404  * 5) Balance, checks etc. for the regional matrices
INCLUDE    C:\Users\pisciell\Documents\AllFiles\CreateSAM\Paolo 2024\Paolo 2024\
           includes\CheckBalance.gms
1406  display  "     Perform some balancing checks" ;
1407   
1408  ** Balance / calculate residual cells
1409  mSAM(reg,fin,ff)$(mapPFin('134',fin) and mapPFin('142',ff)) = TTYZ(reg);
1410  mSAM(reg,fin,ff)$(mapPFin('142',fin) and mapPFin('131',ff)) = sum(sec,LZ(s
      ec,reg));
1411  mSAM(reg,fin,ff)$(mapPFin('142',fin) and mapPFin('135',ff)) = sum(sec,KZ(s
      ec,reg));
1412  mSAM(reg,fin,ff)$(mapPFin('143',fin) and mapPFin('137',ff)) = sum(sec,TAXP
      Z(sec,reg));
1413  mSAM(reg,fin,ff)$(mapPFin('143',fin) and mapPFin('138',ff)) = sum((rr,good
      ),TAXCZR(rr,reg,good));
1414  mSAM(reg,fin,ff)$(mapPFin('145',fin) and mapPFin('144',ff)) = sum(good,SVZ
      (reg,good));
1415  * SROWZ:   AW 6/10 Calculate as balancing item from investment balance (or
       row vs. column sum for '144' ;-) )
1416  SROWZ(reg) = ITZ(reg)+sum(good,SVZ(reg,good))
1417                -sum(sec,INVZ(sec,reg))-SHZ(reg)-SGZ(reg);
1418  *display SROWZ;
1419   
1420  ** AW try 20/10 - alternative calculation; same as in balancing of nationa
      l SAM
1421  ** calculate also TRHROW(reg) here as residual, as in national SAM
1422  ** -- is global trade balance satisfied then? (doubt it)
1423  * Balanserer GOVERNMENT
1424  TRROWZ(reg)=sum(good,CGZ_old(reg,good))+TRANSFZ(reg)+SGZ(reg)-TTYZ(reg)- s
      um(sec,TAXPZ(sec,reg))- sum((rr,good),TAXCZR(rr,reg,good));
1425  *             -TTYZ(reg)- sum((fin,ff)$(mapPFin('143',fin) and mapPFin('13
      7',ff)),mSAM(reg,fin,ff))- sum((fin,ff)$(mapPFin('143',fin) and mapPFin('1
      38',ff)),mSAM(reg,fin,ff));
1426   
1427  * Balanserer HOUSEHOLD
1428  TRHROWZ(reg) = sum(sec,LZ(sec,reg))+sum(sec,KZ(sec,reg))+TRANSFZ(reg)-sum(
      good,CZ_old(reg,good))-TTYZ(reg)-SHZ(reg);
1429   
1430  * OBS: need to write in correct cell, depending on sign (received from or 
      transferred to)
1431  loop(reg,
1432     if(SROWZ(reg)>0,
1433        mSAM(reg,fin,'trade')$mapPFin('144',fin)=SROWZ(reg);
1434     else
1435        mSAM(reg,'trade',fin)$mapPFin('144',fin)=-SROWZ(reg);
1436     );
1437     if (TRROWZ(reg)>0,
1438        mSAM(reg,fin,'trade')$mapPFin('143',fin) = TRROWZ(reg);
1439     else
1440        mSAM(reg,'trade',fin)$mapPFin('143',fin)= -TRROWZ(reg);
1441     );
1442     if (TRHROWZ(reg) > 0,
1443        mSAM(reg,'trade',fin)$mapPFin('142',fin) = TRHROWZ(reg);
1444     else
1445        mSAM(reg,fin,'trade')$mapPFin('142',fin) = -TRHROWZ(reg);
1446     );
1447  );
1448   
1449  **********    ===============================       DATA CHECKS ==========
      ============================     *********
1450   
1451  parameters
1452    diXD(reg,good)
1453    diX(reg,good)
1454    trade_bal(reg,good)
1455    investment_bal(reg) balance of savings and investments
1456    trade_bal_global(reg) global trade balance
1457    salebal(reg,good)
1458    demandbal(reg,good)
1459    tradebal(reg)
1460    invbal(reg)
1461    tradebal_glob(reg)
1462  * to check AW 28/10:
1463    householdbal(reg)
1464    govbal(reg)
1465  ;
1466   
1467   
1468  * a) Sales in a region = domestic supply + exports to RoW and other region
      s
1469  * AW 2/12: bruk XDDZ direkte istf. XDZ og mapSecGood
1470  *diXD(reg,good) = sum(sec$mapSecGood(sec,good),XDZ(sec,reg)) - sum(rr, TRA
      DEZ(good,reg,rr))-  EROWZ(reg,good) ;
1471  diXD(reg,good) = sum(sec,XDDZ(reg,sec,good)) - sum(rr, TRADEZ(good,reg,rr)
      )-  EROWZ(reg,good) ;
1472  salebal(reg,good) = sum(sec,mSAM(reg,sec,good))-mSAM(reg,good,'trade')-mTr
      adeData(good,reg,reg);
1473  *last mSAM term does not include intraregional trade, TRADEZ does -> need 
      also mTradeData for intraregional
1474  display diXD,salebal;
1475   
1476  * b) Demand in a region = import from ROW and other regions (as products o
      r trade & transport margins)
1477  diX(reg,good) = XZ(reg,good)-MROWZ(reg,good) - sum(rr, TRADEZ(good,rr,reg)
       + TMCRZ(rr,reg,good)+ TAXCZR(rr,reg,good) ) ;
1478  *The version with trade and transportmargins included
1479  *diX(reg,good) = XZ(reg,good)-MROWZ(reg,good) - sum(rr, TRADEZ(good,rr,reg
      ) + TMCRZ(rr,reg,good)) ;
1480   
1481  ** AW 27/10: the first 3 lines are XZ
1482  demandbal(reg,good) = sum(sec,mSAM(reg,good,sec))+sum(fin$mapPFin('142',fi
      n),mSAM(reg,good,fin))
1483             + sum(fin$mapPFin('143',fin),mSAM(reg,good,fin))+sum(fin$mapPFi
      n('144',fin),mSAM(reg,good,fin))
1484             + sum(fin$mapPFin('145',fin),mSAM(reg,good,fin))+sum(fin$mapPFi
      n('146',fin),mSAM(reg,good,fin))
1485  *           -mSAM(reg,'trade',good)-mTradeData(good,reg,reg)-sum(rr,mTrade
      Margins(good,rr,reg));
1486             -mSAM(reg,'trade',good)-mTradeData(good,reg,reg)-sum(fin$mapPFi
      n('146',fin),mSAM(reg,fin,good));
1487  * last line:
1488  * use mTradeData as mSAM does *not* contain intraregional trade flows
1489   
1490  trade_bal(reg,good) = diXD(reg,good) - diX(reg,good) ;
1491  display diX, demandbal, trade_bal;
1492   
1493  *loop((reg,good),
1494  *   if (abs(salebal(reg,good)) gt checktol,
1495  *          abort "Sales are not balanced "
1496  *   );
1497  *   if (abs(demandbal(reg,good)) gt checktol,
1498  *          abort "Demands are not balanced "
1499  *   );
1500  *);
1501   
1502  * c) Balance savings and investments
1503  * Ulf's version:
1504  investment_bal(reg) = sum(sec,INVZ(sec,reg)) + SHZ(reg)  + SGZ(reg) + SROW
      Z(reg)
1505  *- sum(good,IZ(reg,good)) - sum(good, SVZ(reg,good));
1506  -ITZ(reg) - sum(good, SVZ(reg,good));
1507   
1508  invbal(reg)=sum((fin,sec)$mapPFin('144',fin),mSAM(reg,fin,sec))+sum((fin,f
      f)$(mapPFin('144',fin) and mapPFin('142',ff)),mSAM(reg,fin,ff))
1509              +sum((fin,ff)$(mapPFin('144',fin) and mapPFin('143',ff)),mSAM(
      reg,fin,ff))+ sum(fin$mapPFin('144',fin),(mSAM(reg,fin,'trade')-mSAM(reg,'
      trade',fin)))
1510  * last two terms:  see calculation of SROWZ in TradeGravity.gms and Olga's
       model - to get sign right
1511  **            -sum(good,mSAM(reg,good,fin)) )-sum((good,fin)$mapPFin('145'
      ,fin),mSAM(reg,good,fin));
1512              -ITZ(reg)-sum((good,fin)$mapPFin('145',fin),mSAM(reg,good,fin)
      );
1513   
1514  Display  investment_bal,invbal ;
1515   
1516  * d) Global trade balance:
1517  * incoming monetary flows (exports) = outgoing mon. flows (imports)
1518  * Ulf's version:
1519  trade_bal_global(reg) =
1520  * Incoming monetary flows (exports)
1521    sum(good,EROWZ(reg,good)) + sum((good,rr),TRADEZ(good,reg,rr)) + sum(goo
      d,TMXZ(reg,good))
1522  *  sum(good,EROWZ(reg,good))
1523   -  TRHROWZ(reg) +  TRROWZ(reg) + SROWZ(reg)
1524  ** AW 20/10: har minus foran TRHROW pga. fortegn til denne (står i rad ist
      f. kolonne, ref. nasj. SAM)
1525  * Outgoing monetary flows (imports)
1526    -  sum(good,MROWZ(reg,good)) - sum((good,rr),TRADEZ(good,rr,reg) + TMCRZ
      (rr,reg,good));
1527  *  -  sum(good,MROWZ(reg,good));
1528   
1529  tradebal_glob(reg)=sum(good,mSAM(reg,good,'trade'))
1530        + (sum(fin$mapPFin('142',fin),mSAM(reg,fin,'trade')-mSAM(reg,'trade'
      ,fin)))
1531        + (sum(fin$mapPFin('143',fin),mSAM(reg,fin,'trade') - mSAM(reg,'trad
      e',fin)))
1532        + (sum(fin$mapPFin('144',fin),mSAM(reg,fin,'trade') - mSAM(reg,'trad
      e',fin)))
1533        - sum(good,mSAM(reg,'trade',good)) ;
1534  *mSAM terms for EROW / MROW do not include intraregional trade, TRADEZ doe
      s -> need also mTradeData for intraregional
1535  *But these cancel each other out (first & last line)
1536  Display trade_bal_global,tradebal_glob;
1537   
1538  * AW 28/10 to check
1539  householdbal(reg)= TRHROWZ(reg)- (sum(sec,LZ(sec,reg))+sum(sec,KZ(sec,reg)
      )+TRANSFZ(reg)-sum(good,CZ_old(reg,good))-TTYZ(reg)-SHZ(reg));
1540  display householdbal;
1541  govbal(reg)=  TRROWZ(reg)-(sum(good,CGZ_old(reg,good))+TRANSFZ(reg)+SGZ(re
      g)-TTYZ(reg)- sum(sec,TAXPZ(sec,reg))- sum((rr,good), TAXCZR(rr,reg,good))
      );
1542  display govbal;
1543   
1544   
1545  **AW 20/10
1546  *loop(reg,
1547  *   if (abs(investment_bal(reg)) gt checktol ,
1548  *          abort "There is no global investment balance"
1549  *   );
1550  *  if (abs(trade_bal_global(reg)) gt checktol ,
1551  *         abort "There is no global trade balance"
1552  *  );
1553  *);
1554   
1555  ** ====================== Calculate 'tot' row and column sums and add to m
      SAM
1556  *** AW 13/10: unsure if this is needed at all
1557  * 'trade' includes all export from the region (to other regions and to RoW
      )
1558  * this cell is not included in Fin vector, replaces RoW -> must add separa
      tely
1559  mSAM(reg,good,'tot')=sum(gg,mSAM(reg,good,gg))+sum(sec,mSAM(reg,good,sec))
      +sum(fin,mSAM(reg,good,fin))+mSAM(reg,good,'trade');
1560  mSAM(reg,sec,'tot')=sum(good,mSAM(reg,sec,good))+sum(ss,mSAM(reg,sec,ss))+
      sum(fin,mSAM(reg,sec,fin))+mSAM(reg,sec,'trade');
1561  mSAM(reg,fin,'tot')=sum(good,mSAM(reg,fin,good))+sum(sec,mSAM(reg,fin,sec)
      )+sum(ff,mSAM(reg,fin,ff))+mSAM(reg,fin,'trade');
1562  mSAM(reg,'trade','tot')=sum(good,mSAM(reg,'trade',good))+sum(sec,mSAM(reg,
      'trade',sec))+sum(ff,mSAM(reg,'trade',ff))+mSAM(reg,'trade','trade');
1563  * 'trade' includes all import into the region (from other regions and from
       RoW)
1564  * this cell is not included in Fin vector -> must add separately
1565  mSAM(reg,'tot',good)=sum(gg,mSAM(reg,gg,good))+sum(sec,mSAM(reg,sec,good))
      +sum(fin,mSAM(reg,fin,good))+mSAM(reg,'trade',good);
1566  mSAM(reg,'tot',sec)=sum(good,mSAM(reg,good,sec))+sum(ss,mSAM(reg,ss,sec))+
      sum(fin,mSAM(reg,fin,sec))+mSAM(reg,'trade',sec);
1567  mSAM(reg,'tot',fin)=sum(good,mSAM(reg,good,fin))+sum(sec,mSAM(reg,sec,fin)
      )+sum(ff,mSAM(reg,ff,fin))+mSAM(reg,'trade',fin);
1568  mSAM(reg,'tot','trade')=sum(good,mSAM(reg,good,'trade'))+sum(sec,mSAM(reg,
      sec,'trade'))+sum(ff,mSAM(reg,ff,'trade'))+mSAM(reg,'trade','trade');
1569   
1570   
1571   
1572  Execute_unload "sjekk", XZ,XXDZ,MROWZ,TRADEZ,TMCRZ, EROWZ
1573   
1574  **Execute_unload "check", EROWZ, MROWZ, TRADEZ, XZ
1575  *Execute_unload "msam_bal", mSAM, cnt, com, sec, mTradeData, mTradeMargins
      , mapSecGood,CZ_old,CGZ_old,IZ_old, IOZ_old, ITZ,CBUDZ,CBUDGZ
1576  Execute_unload "msam_bal", mSAM, cnt, com, sec, mTradeData, mTradeMargins,
       CZ_old,CGZ_old,IZ_old, IOZ_old, ITZ,CBUDZ,CBUDGZ, distrgood_share_public,
       elas_sec_s, elas_sec_s1, elas_prod_s, elas_prod_s1, elas_prod_s2, elas_pr
      od_s3
1577  *Execute 'gdx2xls msam_bal'
