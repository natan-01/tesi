 224  parameters
 225  * goods / sector submatrices
 226  **       distrGoodUseSAM(good,sec) !! nation-wide usage pattern of commodity by sector (user case levels)
 227         distrGoodSupplySAM(sec,good) !! nation-wide supply pattern of commodity by sector (user case levels)
 228  * submatrices, P.., mapped to user goods, sectors and Fin, national level
 229         UGFN(good,fin)
 230         USFN(sec,fin), UFGN(fin,good), UFSN(fin,sec), UFFN(fin,fin)
 231         USGN(sec,good), UGSN(good,sec)
 232         SAMnat(*,*)     !! aggregated 1-region SAM, unchecked for consistency
 233  * disaggregation keys - national to county to regional level
 234         distrPCounty(*,*,*)   !! Distribution key from Panda to county levels - all data = whole .xlsx-sheet
 235         distrPCountyProd(county,sec) !! supply disaggregation key mapped to user sectors
 236         distrPCountyAnv(county,sec) !! usage disaggregation key mapped to user sectors
 237         distrPCountyProdN(county,*),distrPCountyAnvN(county,*)    !! normalised distribution keys based on production and on usage (anvendelse)
 238         distrPRegProdN(reg,sec) !! normalised supply disaggregation key mapped to user sectors and regions
 239         distrGoodRegProdN(reg,good)  !! normalised supply disaggregation key mapped to user goods and regions
 240         distrPRegAnvN(reg,sec) !! normalised usage disaggregation key mapped to user sectors
 241         distrPCountyincome(county) !! income (consumption) disaggregation
 242         distrPCountyincome_sec(county,sec) !! income (consumption) disaggregation
 243         distrsecRegincomeN(reg,sec)  !! normalised supply disaggregation key mapped to user goods and regions
 244         distrGoodRegincomeN(reg,good)  !! normalised supply disaggregation key mapped to user goods and regions
 245         distrsec_public(reg,sec)  !! local public key
 246         distrsec_local(reg,sec)  !! local public key
 247         distrGood_public(reg,good)  !! local public key
 248         distrGood_local(reg,good)  !! local public key
 249         distrPCountyincomeN(county) !! normalised income (consumption) disaggregation
 250         distrPRegincomeN(reg)        !! normalised income (consumption) aggregation mapped to regions
 251         sumpsg(sec)       !! AW 16-12
 252         ;
 253   
 254  * nation-wide pattern (ratio) of usage of commodities by sectors (both on user case level)
 255  *distrGoodUseSAM(good,sec) = sum((Pgood,Psec)$(mapPGood(Pgood,good) and mapPSec(Psec,sec)),PGS(Pgood,Psec)) / sum((Pgood,Psec)$mapPGood(Pgood,good),PGS(Pgood,Psec));
 256  * ... and of supply of commodities by sectors
 257   
 258  * AW 16/12
 259  sumpsg(sec)= sum((Psec,Pgood)$mapPSec(Psec,sec),PSG(Psec,Pgood));
 260  *display sumpsg;
 261   
 262  loop(sec,
 263   if (sumpsg(sec),
 264      distrGoodSupplySAM(sec,good)=  sum((Psec,Pgood)$(mapPGood(Pgood,good) and mapPSec(Psec,sec)),PSG(Psec,Pgood)) / sumpsg(sec);
 265   else
 266      distrGoodSupplySAM(sec,good) = 1/card(good);
 267  );
 268    );
 269   
 270  *distrGoodSupplySAM(sec,good)=  sum((Psec,Pgood)$(mapPGood(Pgood,good) and mapPSec(Psec,sec)),PSG(Psec,Pgood)) / sum((Psec,Pgood)$mapPSec(Psec,sec),PSG(Psec,Pgood));
