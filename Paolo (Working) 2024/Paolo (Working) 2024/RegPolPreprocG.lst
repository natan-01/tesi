 490   
 491  *scal = 1000000;
 492  scal = 1;
 493   
 494  * Checking the sum value of the user SAM
 495  SAM_sum_u = sum((good,sec),UGSN(good,sec))+sum((good,fin),UGFN(good,fin))+
      sum((sec,good),USGN(sec,good))+sum((sec,fin),USFN(sec,fin))+sum((fin,good)
      ,UFGN(fin,good))+sum((fin,sec),UFSN(fin,sec))
 496  +sum((fin,ff),UFFN(fin,ff));
