GDXIN   C:\Users\natis\Downloads\Paolo (Working) 2024\Paolo (Working) 2024\DisAgg.gdx
--- LOAD  county = 2:county
--- LOAD  distrPCounty = 1:distrPCounty
 298   
 299   
 300  * map the keys for disaggregation to county level into user sectors and normalise
 301  ** AW 16/10: don't need the normalised county versions anymore?
 302  * production in this county and sector
 303  distrPCountyProd(county,sec)=sum(Psec$mapPSec(Psec,sec),distrPCounty(county,Psec,"prod"));
 304  *distrPCountyProdN(county,sec) = distrPCountyProd(county,sec)/sum(cc, distrPCountyProd(cc,sec));
 305  * product usage in this county and sector
 306  distrPCountyAnv(county,sec) = sum(Psec$mapPSec(Psec,sec),distrPCounty(county,Psec,"tot_anv"));
 307  *distrPCountyAnvN(county,sec) = distrPCountyAnv(county,sec)/sum(cc, distrPCountyAnv(cc,sec));
 308  * income in this county
 309  * distrPCountyincome(county) = sum(Psec,distrPandaCounty(county,Psec,"income"));
 310  * AW 26/9-14: benytter konsum - ble dette riktig nå?
 311  distrPCountyincome(county) = sum(Psec,distrPCounty(county,Psec,"konsum_hush"))+ sum(Psec,distrPCounty(county,Psec,"konsum_stat"))+sum(Psec,distrPCounty(county,Psec,"konsum_komm"));
 312  distrPCountyincome_sec(county,sec) = sum(Psec$mapPSec(Psec,sec),distrPCounty(county,Psec,"konsum_hush"))+ sum(Psec$mapPSec(Psec,sec),distrPCounty(county,Psec,"konsum_stat"))+sum(Psec$mapPSec(Psec,sec),distrPCounty(county,Psec,"konsum_komm"));
 313   
 314  distrsec_public(reg,sec)=  sum((Psec,county)$(mapPSec(Psec,sec) and mapCMtoReg(county,reg)),distrPCounty(county,Psec,"konsum_stat"))     ;
 315  distrsec_local(reg,sec)=  sum((Psec,county)$(mapPSec(Psec,sec) and mapCMtoReg(county,reg)),distrPCounty(county,Psec,"konsum_komm"))     ;
 316   
 317  *distrPCountyincomeN(county) = distrPCountyincome(county)/sum(cc, distrPCountyincome(cc));
