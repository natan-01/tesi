1070  matrise1(good, "TAXCZ") =  TAXCZ(good);
1071  matrise1(good, "TMCZ") =  TMCZ(good);
1072  matrise1(good, "D") =  - sum(reg,SUM_d(reg,good));
1073  matrise1(good, "ch_difference") =  sum(reg,SUM_o(reg,good)) + TAXCZ(good) + TMCZ(good) - sum(reg,SUM_d(reg,good));
1074  matrise1(good, "MROWZ") =  sum(reg,MROWZ(reg,good));
1075  matrise1(good, "EROWZ") =  sum(reg,EROWZ(reg,good));
1076  matrise1(good, "XZ - MROWZ") =  sum(reg,XZ(reg,good))-sum(reg,MROWZ(reg,good));
1077  matrise1(good, "XDDZ - EROWZ") =  sum((sec,reg),XDDZ(reg,sec,good))-sum(reg,EROWZ(reg,good));
1078  * =================                                                               ====================== *
