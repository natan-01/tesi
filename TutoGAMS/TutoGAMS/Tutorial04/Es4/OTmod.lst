  38  domenica.mercoledi
  39  domenica.giovedi
  40  domenica.venerdi
  41  domenica.sabato
  42  domenica.domenica
  43  /;
  44   
  45  parameter num_min(giorni) /
  46  lunedi=28
  47  martedi=18
  48  mercoledi=20
  49  giovedi=26
  50  venerdi=22
  51  sabato=13
  52  domenica=13
  53  /;
  54   
  55  parameter paga(giorni)/
  56  lunedi=250
  57  martedi=270
  58  mercoledi=310
  59  giovedi=319
  60  venerdi=310
  61  sabato=310
  62  domenica=285
  63  /;
  64   
  65  alias(giorno,giorni);
  66   
  67  positive variable x(giorni) numero operatori;
  68  variable z;
  69   
  70  equation fo, minreq(giorni);
  71   
  72  fo..
  73           z=e=sum(giorni,paga(giorni)*x(giorni));
  74   
  75  minreq(giorno)..
  76           sum(giorni$allavoro(giorno,giorni),x(giorni))=g=num_min(giorno);
  77   
  78  model OT /all/;
  79   
  80  solve OT using mip minimizing z;
  81   
  82  display x.l;


