C o m p i l a t i o n


   1  option mip=cplex;
   2   
   3  set localizzazioni /A,B,C,D,E/
   4   
   5  set strade /a1,a2,a3,a4,a5,a6,a7,a8,a9/
   6   
   7  parameter costoLoc(localizzazioni)
   8  /
   9  A=100
  10  B=75
  11  C=120
  12  D=125
  13  E=95
  14  /;
  15   
  16   
  17  set copertura(localizzazioni,strade)
  18  /
  19  A.a1
  20  A.a2
  21  B.a2
  22  B.a3
  23  B.a4
  24  B.a5
  25  B.a6
  26  C.a3
  27  C.a4
  28  C.a5
  29  C.a9
  30  D.a6
  31  D.a7
  32  D.a8
  33  E.a1
  34  E.a4
  35  E.a5
  36  E.a9
  37  /;
  38   
  39  binary variable C(localizzazioni);
  40  variable z fo;
  41   
  42  equation cop(strade);
  43  cop(strade)..
  44           sum(localizzazioni$copertura(localizzazioni,strade),C(localizzazi
      oni))=g=1;
  45   
  46  equation obj;
  47  obj..
  48           z=e=sum(localizzazioni,costoLoc(localizzazioni)*C(localizzazioni)
      );
  49   
  50  model Assist /all/;
  51   
  52  solve Assist using mip minimizing z;
  53   
  54  display C.l;
  55   


