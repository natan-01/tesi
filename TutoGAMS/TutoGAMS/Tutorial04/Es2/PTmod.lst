C o m p i l a t i o n


   1  option lp=cplex;
   2   
   3  set attivita /camminare,jogging,nuoto,ginnastica,bicicletta/;
   4  set allaperto(attivita) / camminare,jogging,bicicletta/;
   5   
   6   
   7  parameter calorie(attivita)
   8  /
   9  camminare=100
  10  jogging =300
  11  nuoto=200
  12  ginnastica=250
  13  bicicletta=150
  14  /;
  15   
  16  parameter maxore(attivita)
  17  /
  18  camminare=6
  19  jogging =3
  20  nuoto=0.8
  21  ginnastica=3
  22  bicicletta=5
  23  /;
  24   
  25  equation fo, oretot, percentaperto,minaperto;
  26  positive variable x(attivita);
  27  variable z;
  28   
  29  x.up(attivita)=maxore(attivita);
  30   
  31  fo..
  32           z=e=sum(attivita,calorie(attivita)*x(attivita));
  33   
  34  minaperto..
  35           sum(attivita$allaperto(attivita),x(attivita))=g=2;
  36   
  37   
  38  oretot..
  39           sum(attivita,x(attivita))=e=8;
  40   
  41  percentaperto..
  42           sum(attivita$allaperto(attivita),calorie(attivita)*x(attivita))=l
      =0.5*sum(attivita,calorie(attivita)*x(attivita));
  43   
  44  model PT /all/;
  45   
  46  solve PT using lp maximizing z;
  47   
  48  display x.l;


