  83  cop(localizzazioni)..
  84           sum(loc$cover(localizzazioni,loc),x(loc))=g=1;
  85   
  86  equation fo1;
  87  fo1..
  88    z=e=sum(localizzazioni,costo(localizzazioni)*x(localizzazioni));
  89   
  90   
  91  equation fo2;
  92  fo2..
  93    z=e=sum(localizzazioni,x(localizzazioni));
  94   
  95  model local1 /cop,fo1/;
  96  model local2 /cop,fo2/;
  97   
  98  solve local1 using mip minimizing z;
  99  display x.l,z.l;
 100   
 101  solve local2 using mip minimizing z;
