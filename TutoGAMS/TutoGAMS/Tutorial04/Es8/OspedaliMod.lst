G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  option limrow=1000
   2   
   3  option mip=cplex;
   4   
   5  set citta /Latina,Lecce,Matera,Napoli,Potenza,Salerno,Roma/;
   6  alias(citta,citta1,citta2);
      E' necessario fare l'alias altrimenti GAMS prende la stessa citta da entra
      mbe le parti. non crea un sottoinsieme del prodotto cartesiano.
  10  set vicini(citta1,citta2)
  11  /
  12  Latina.Latina
  13  Latina.Napoli
  14  Latina.Roma
  15  Lecce.Lecce
  16  Lecce.Matera
  17  Matera.Matera
  18  Matera.Lecce
  19  Matera.Potenza
  20  Napoli.Napoli
  21  Napoli.Latina
  22  Napoli.Potenza
  23  Napoli.Salerno
  24  Potenza.Potenza
  25  Potenza.Matera
  26  Potenza.Napoli
  27  Potenza.Salerno
  28  Salerno.Salerno
  29  Salerno.Napoli
  30  Salerno.Potenza
  31  Roma.Roma
  32  Roma.Latina
  33  /;
  34   
  35  binary variable ospedale(citta);
  36  variable z funzione obiettivo;
  37   
  38  equation fo, cover(citta);
  39   
  40  fo..
  41           z=e=sum(citta,ospedale(citta));
  42   
  43  cover(citta1)..
  44           sum(citta2$vicini(citta1,citta2),ospedale(citta2))=g=1;
  45   
  46  model Ospedali /all/;
  47   
  48  solve Ospedali using mip minimizing z;
  49   
  50  display ospedale.l;


