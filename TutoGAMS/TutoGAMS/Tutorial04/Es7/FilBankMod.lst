C o m p i l a t i o n


   1  option mip = cplex;
   2   
   3   
   4  set filiali /A,B,C,D,E,F,G,H,I/;
   5  set province /CZ,CS,KR,RC,VV/;
   6   
   7  set allocazione(filiali,province) dove possiamo aprire le filiali
   8  /
   9  A.RC
  10  B.CS
  11  C.RC
  12  D.KR
  13  E.CZ
  14  F.VV
  15  G.CZ
  16  H.VV
  17  I.RC
  18  /;
  19   
  20  parameter costiattivazione(filiali)
  21  /
  22  A=50
  23  B=40
  24  C=30
  25  D=25
  26  E=40
  27  F=50
  28  G=60
  29  H=40
  30  I=30
  31  /;
  32   
  33  parameter potenzialiclienti(filiali)
  34  /
  35  A=300
  36  B=100
  37  C=250
  38  D=200
  39  E=400
  40  F=120
  41  G=100
  42  H=100
  43  I=400
  44  /;
  45   
  46  binary variable x(filiali) apertura filiale;
  47  variable z fo;
  48  scalar budget /200/;
  49   
  50  equation budgetc,minfiliali1(province),minfiliali2(province),maxfiliali(pr
      ovince),fo;
  51   
  52  fo..
  53           z=e=sum(filiali,potenzialiclienti(filiali)*x(filiali));
  54   
  55  budgetc..
  56           sum(filiali,costiattivazione(filiali)*x(filiali))=l=budget;
  57   
  58  minfiliali1('RC')..
  59           sum(filiali$allocazione(filiali,'RC'),x(filiali))=g=2;
  60   
  61  minfiliali2('CZ')..
  62           sum(filiali$allocazione(filiali,'CZ'),x(filiali))=g=1;
  63   
  64   
  65  maxfiliali('VV')..
  66           sum(filiali$(allocazione(filiali,'VV') ),x(filiali))=l=2;
  67   
  68   
  69  model FilBank /all/;
  70   
  71  FilBank.optcr=0
  72   
  73  solve FilBank using mip maximizing z;
  74   
  75   
  76   
  77  display x.l;


