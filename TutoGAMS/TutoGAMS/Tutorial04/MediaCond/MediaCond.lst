4015  /;
4016   
4017  parameter costi(produttore)/
4018  A=70
4019  B=45
4020  C=12
4021  /;
4022  positive variable v(s);
4023  variable z funzione obiettivo;
4024   
4025  equation fo;
4026  fo..
4027           sum(s,X(s)*v(s))/0.01=e=z;
4028   
4029  equation percent;
4030  percent..
4031           sum(s,v(s))=e=0.01;
4032   
4033  equation probound(s);
4034  probound(s)..
4035  v(s)=l=1/card(s);
4036   
4037  model condmean /fo,percent,probound/;
4038   
4039  solve condmean using lp minimizing z;
4040   
4041  display z.l, v.l;
4042   
4043   
4044  variable zd, eta;
4045  positive variable y(s);
4046   
4047  equation fod;
4048  fod..
4049  eta-sum(s,y(s))/(card(s)*0.01)=e=zd;
4050   
4051  equation mind(s);
4052  mind(s)..
4053  y(s)=g=eta-X(s);
4054   
4055  model dual /fod,mind/;
4056  solve dual using lp maximizing zd;
4057   
4058  display zd.l;
4059   
4060  *----------------- Modello 3 ------
4061   
4062  scalar Garanzia /4/;
4063   
4064  positive variable q(produttore);
4065  variable zP;
4066   
4067  equation foP;
4068  foP..
4069           sum(produttori, costi(produttori)*q(produttori))=e=zP;
4070   
4071  equation totPort;
4072  totport..
4073  sum(produttori,q(produttori))=e=1;
4074   
4075  equation PosCV(s);
4076  PosCV(s)..
4077  y(s)=g=eta-sum(produttori, D(produttori,s)*q(produttori));
4078   
4079  equation CVaR;
4080  CVaR..
4081  eta-sum(s,y(s)*1/(card(s)))/0.01 =g= Garanzia;
4082   
4083  model AllocazioneProduzione /foP,totPort,PosCV,CVaR/;
4084   
4085  solve AllocazioneProduzione using lp minimizing zP;
4086   
4087  parameter optCVaR;
4088  optCVaR=eta.l-sum(s,y.l(s)*1/(card(s)))/0.01
4089   
4090  display q.l, optCVaR;
