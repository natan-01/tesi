C o m p i l a t i o n


   1  option mip=cplex;
   2   
   3  set stabilimenti /s1,s2,s3/;
   4  set retail /p1,p2,p3,p4/;
   5   
   6  parameter costo_attivazione(stabilimenti)
   7  /
   8  s1=9000
   9  s2=7000
  10  s3=8000
  11  /;
  12   
  13  parameter domanda(retail)
  14  /
  15  p1=150
  16  p2=400
  17  p3=200
  18  p4=300
  19  /;
  20   
