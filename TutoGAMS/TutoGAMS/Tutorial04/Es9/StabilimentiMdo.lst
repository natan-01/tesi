  30  s2.p4=40
  31  s3.p1=40
  32  s3.p2=50
  33  s3.p3=60
  34  s3.p4=70
  35  /;
  36   
  37   
  38  parameter capacita(stabilimenti)
  39  /
  40  s1=700
  41  s2=900
  42  s3=800
  43  /;
  44   
  45   
  46  equation fo,dom(retail),cap(stabilimenti);
  47   
  48  positive variable trasporto(stabilimenti,retail);
  49  binary variable attivazione(stabilimenti);
  50  variable z fo;
  51   
  52  trasporto.up(stabilimenti,retail)=900;
  53   
  54  fo..
  55           z=e=
  56     sum((retail,stabilimenti), costo_trasporto(stabilimenti,retail)*traspor
      to(stabilimenti,retail))
  57   + sum(stabilimenti,costo_attivazione(stabilimenti)* attivazione(stabilime
      nti));
  58   
  59  cap(stabilimenti)..
  60           sum(retail,trasporto(stabilimenti,retail))=l=capacita(stabiliment
      i)*attivazione(stabilimenti);
  61   
  62  dom(retail)..
  63           sum(stabilimenti,trasporto(stabilimenti,retail))=g=domanda(retail
      );
  64   
  65  model Stabil /all/;
  66  Stabil.optcr=0;
  67  solve Stabil using mip minimizing z;
  68  display attivazione.l, trasporto.l;
  69   
  70  parameter utilizzo(stabilimenti);
  71  utilizzo(stabilimenti)=sum(retail,trasporto.l(stabilimenti,retail));
  72   
  73  display utilizzo;


