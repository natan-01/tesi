C o m p i l a t i o n


   1  *option solver lp= cplex;
   3  option limrow=700;
   4   
INCLUDE    C:\Users\pisciella\Dropbox\CORSO Ricerca Operativa\GAMS tutorial\Tuto
           rial 3\shippingdata.gms
   6  set impianti commenti vari /Seattle, San-Diego/;
   7  set mercati insieme dei mercati /New-York, Chicago, Topeka/;
   8   
   9  parameter a(impianti) capacita massima impianti /
  10  Seattle=350
  11  San-Diego=600
  12  /;
  13   
  14  parameter b(mercati) domanda minima /
  15  New-York = 325
  16  Chicago = 300
  17  Topeka=275
  18  /;
  19   
  20  parameter costi(impianti,mercati) /
  21  Seattle.New-York = 2.5
  22  Seattle.Chicago = 1.7
  23  Seattle.Topeka = 1.8
  24  San-Diego.New-York = 2.5
  25  San-Diego.Chicago = 1.8
  26  San-Diego.Topeka = 1.4
  27  /;
  28   
  29  set collegamenti(impianti,mercati) Topeka è raggiungibile solo da Seattle
  30  /
  31  Seattle.New-York
  32  Seattle.Chicago
  33  Seattle.Topeka
  34  San-Diego.New-York
  35  San-Diego.Chicago
  36  /;
  37   
  38  equations obiettivo, capmax, dommin;
  39   
  40  variable z;
  41  positive variable x(impianti,mercati);
  42   
  43  alias(impianti,i);
  44  alias(mercati,j);
  45   
  46  obiettivo..
  47           z=e=sum((i,j),costi(i,j)*x(i,j));
  48   
  49  capmax(i)..
  50           sum(j$collegamenti(i,j),x(i,j))=l=a(i);
  51   
  52  dommin(j)..
  53           sum(i$collegamenti(i,j),x(i,j))=g=b(j);
  54   
  55  model nomemodello /obiettivo,capmax,dommin/;
  56   
  57  solve nomemodello using lp minimizing z;
  58   
  59  display x.l;
